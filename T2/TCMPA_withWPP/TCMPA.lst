 470  * 3.0 Unported License http://creativecommons.org/licenses/by-nc-nd/3.0/
 471  *********************************************************************************
 472  * File for the Matlab function TCMPA_BF.m to represent the aggregated
 473  * bid functions and the matched energy for each time period.
 474  *
 475  file MPA_eq  /TCMPA_eq_T.dat/; put MPA_eq;
 476  scalar aux;
 477  loop(t,
 478  aux = sum(d, sum(bd, lbd(t,d,bd)*PD.l(t,d,bd))) - sum(g, sum(bg, lbg(t,g,bg)*PG.l(t,g,bg)));
 479  put sum(g, sum(bg, PG.l(t,g,bg)));
 480  put sum(b, market_equilibrium(t,b,'price'));
 481  put aux;
 482  put /);
 483   
 484  file MPA_lbg /TCMPA_lbg_T.dat/; put MPA_lbg; loop(t, loop(g, loop(bg, put lbg(t,g,bg)));  put /);
 485  file MPA_pbg /TCMPA_pbg_T.dat/; put MPA_pbg; loop(t, loop(g, loop(bg, put pbg(t,g,bg)));  put /);
 486  file MPA_PG  /TCMPA_PG_T.dat/;  put MPA_PG;  loop(t, loop(g, loop(bg, put PG.l(t,g,bg))); put /);
 487  file MPA_lbd /TCMPA_lbd_T.dat/; put MPA_lbd; loop(t, loop(d, loop(bd, put lbd(t,d,bd)));  put /);
 488  file MPA_pbd /TCMPA_pbd_T.dat/; put MPA_pbd; loop(t, loop(d, loop(bd, put pbd(t,d,bd)));  put /);
 489  file MPA_PD  /TCMPA_PD_T.dat/;  put MPA_PD;  loop(t, loop(d, loop(bd, put PD.l(t,d,bd))); put /);
 490   
 491  file MPA_PGT  /TCMPA_PGT.dat/;
 492  *file MPA_PGmin /TCMPA_PGmin.dat/;
 493  *file MPA_PGmax /TCMPA_PGmax.dat/;
 494  *file MPA_PGRU /TCMPA_PGRU.dat/;
 495  *file MPA_PGRD /TCMPA_PGRD.dat/;
 496   
 497  put MPA_PGT;
 498  loop(g,
 499  loop(t0, put PGT.l(t0,g)); put/;
 500  loop(t0, put pg_min(g)) ; put/;
 501  loop(t0, put pg_max(g)) ; put/;
 502  loop(t0, put rd(g))     ; put/;
 503  loop(t0, put ru(g))     ; put/;
 504  );
 505  * ... for TCMPA_BFNodal.m
 506  SET bout(b) /'bus1'/
INCLUDE    C:\Users\citcea\Documents\GitHub\MUSAE\MUSAE_energy_markets\T2\TCMPA_withWPP\TCMPA2M.gms
 508  ********************************************************************************
 509  * F.-Javier Heredia f.javier.heredia(at)upc.edu http://gnom.upc.edu/heredia
 510  * Code under Creative Commons Attribution-NonCommercial-NoDerivs
 511  * 3.0 Unported License http://creativecommons.org/licenses/by-nc-nd/3.0/
 512  ********************************************************************************
 513   
 514  file TCMPA_bus /TCMPA_bus.dat/;
 515  file TCMPA_eq  /TCMPA_eq.dat/;
 516  file TCMPA_lbg /TCMPA_lbg.dat/;
 517  file TCMPA_pbg /TCMPA_pbg.dat/;
 518  file TCMPA_PG  /TCMPA_PG.dat/;
 519  file TCMPA_lbd /TCMPA_lbd.dat/;
 520  file TCMPA_pbd /TCMPA_pbd.dat/;
 521  file TCMPA_PD  /TCMPA_PD.dat/;
 522   
 523  put TCMPA_bus; loop(bout, put bout.tl);
 524  put TCMPA_eq;
 525  scalar aux;
 526  loop(b$bout(b),
 527           loop(t,
 528                   put market_equilibrium(t,b,'energy');
 529                   put market_equilibrium(t,b,'price');
 530                   put market_equilibrium(t,b,'nodal SW');
 531                   put /
 532           );
 533  );
 534   
 535  loop(b$bout(b),
 536  put TCMPA_lbg;
 537  loop(t,
 538           loop(g$gb(g,b), loop(bg, put  lbg(t,g,bg)));
 539  *        Positive Inflow => generation unit
 540           loop(b_o$(l(b_o,b) and P.l(t,b_o,b)>0), put NODAL_MARKET.m(t,b_o));
 541  *        Negative Outflow => generation unit
 542           loop(b_d$(l(b,b_d) and P.l(t,b,b_d)<0), put NODAL_MARKET.m(t,b_d));
 543           put /);
 544  put TCMPA_pbg;
 545  loop(t,
 546           loop(g$gb(g,b), loop(bg, put  pbg(t,g,bg)));
 547  *        Positive Inflow => generation unit
 548           loop(b_o$(l(b_o,b) and P.l(t,b_o,b)>0), put  P.up(t,b_o,b));
 549  *        Negative Outflow => generation unit
 550           loop(b_d$(l(b,b_d) and P.l(t,b,b_d)<0), aux = -P.lo(t,b,b_d); put aux);
 551           put /);
 552  put TCMPA_PG;
 553  loop(t,
 554           loop(g$gb(g,b), loop(bg, put PG.l(t,g,bg)));
 555  *        Positive Inflow => generation unit
 556           loop(b_o$(l(b_o,b) and P.l(t,b_o,b)>0), put  P.l(t,b_o,b));
 557  *        Negative Outflow => generation unit
 558           loop(b_d$(l(b,b_d) and P.l(t,b,b_d)<0), aux = -P.l(t,b,b_d); put aux);
 559           put /);
 560  put TCMPA_lbd;
 561  loop(t,
 562           loop(d$db(d,b), loop(bd, put  lbd(t,d,bd)));
 563  *        Negative Inflow => demand unit
 564           loop(b_o$(l(b_o,b) and P.l(t,b_o,b)<0), put NODAL_MARKET.m(t,b_o));
 565  *        Positive Outflow => demand unit
 566           loop(b_d$(l(b,b_d) and P.l(t,b,b_d)>0), put NODAL_MARKET.m(t,b_d));
 567           put /);
 568  put TCMPA_pbd;
 569  loop(t,
 570           loop(d$db(d,b), loop(bd, put  pbd(t,d,bd)));
 571  *        Negative Inflow => demand unit
 572           loop(b_o$(l(b_o,b) and P.l(t,b_o,b)<0), aux = -P.lo(t,b_o,b); put aux);
 573  *        Positive Outflow => demand unit
 574           loop(b_d$(l(b,b_d) and P.l(t,b,b_d)>0), put  P.up(t,b,b_d));
 575           put /);
 576  put TCMPA_PD;
 577  loop(t,
 578           loop(d$db(d,b), loop(bd, put PD.l(t,d,bd)));
 579  *        Negative Inflow => demand unit
 580           loop(b_o$(l(b_o,b) and P.l(t,b_o,b)<0), aux = -P.l(t,b_o,b); put aux);
 581  *        Positive Outflow => demand unit
 582           loop(b_d$(l(b,b_d) and P.l(t,b,b_d)>0), put  P.l(t,b,b_d));
 583           put /);
 584  );
 585   
 586  *file TCMPA_PGT   /TCMPA_PGT.dat/;
 587  *file TCMPA_PGmin /TCMPA_PGmin.dat/;
 588  *file TCMPA_PGmax /TCMPA_PGmax.dat/;
 589  *file TCMPA_PGRU  /TCMPA_PGRU.dat/;
 590  *file TCMPA_PGRD  /TCMPA_PGRD.dat/;
 591   
 592  *put TCMPA_PGT;
 593  *loop(g,
 594  *loop(t0, put PGT.l(t0,g)); put/;
 595  *loop(t0, put pg_min(g)) ; put/;
 596  *loop(t0, put pg_max(g)) ; put/;
 597  *loop(t0, put rd(g))     ; put/;
 598  *loop(t0, put ru(g))     ; put/;
 599  *);
