 149   
 150  * Buses:
 151   
 152  SET  b      Buses            / bus1*bus4 /;
 153  SET refb(b) Reference bus    / bus1 /;
 154  alias(b,b_o,b_d);
 155   
 156  SET gb(g,b) Generation buses / G1.bus1, G2.bus1, G3.bus2, G4.bus2, G5.bus4 ,G6.bus3/;
 157  SET db(d,b) Demand buses     / D1.bus1, D2.bus2, D3.bus3 /;
 158   
 159  * Lines;
 160   
 161  SET l(b_o,b_d) lines / bus1.bus2, bus1.bus3, bus2.bus3, bus2.bus4, bus3.bus4 /;
 162   
 163  display gb, db, refb, l;
 164   
 165  PARAMETERS pbase basepower [MVAr] / 100 /;
 166  TABLE x(b,b) Line reactance [p.u.]
 167        bus1 bus2   bus3  bus4
 168  bus1   0.0  0.058 0.04  0.0
 169  bus2   0.0  0.0   0.08  0.08
 170  bus3   0.0  0.0   0.0   0.12
 171  bus4   0.0  0.0   0.0   0.0  ;
 172   
 173  TABLE s_max(b,b) Line capacity [MVA]
 174         bus1 bus2 bus3  bus4
 175  bus1   150  150  150   150
 176  bus2   150  150  150   150
 177  bus3   150  150  150   150
 178  bus4   150  150  150   150  ;
 179   
 180  *********************************************************************
 181  * VARIABLES
 182  *********************************************************************
 183   
 184  FREE VARIABLE     SW         Social welfare (objective function);
 185  * Generation;
 186  POSITIVE VARIABLE PG(t,g,bg) Matched generation of each block [MW]
 187                    PGT(t0,g)  Total matched generation [MW]
 188  BINARY VARIABLE   U(t,g)     on-off state of the unit;
 189  * Total generation at t=0:
 190  PGT.fx('t0',g) = p0(g);
 191   
 192  * Demand;
 193  POSITIVE VARIABLE PD(t,d,bd) Matched demand of each block [MW]
 194                    PDT(t,d)   Total matched demand [MW];
 195  * Grid;
 196  VARIABLE P(t,b,b)   Line power [MW]
 197           Th(t,b)    Voltage phase;
 198   
 199  P.fx(t,b_o,b_d)$(not l(b_o,b_d)) = 0.0;
 200  P.lo(t,b_o,b_d)   = -s_max(b_o,b_d);
 201  P.up(t,b_o,b_d)   = s_max(b_o,b_d);
 202   
 203  Th.fx(t,refb) = 0.0;
 204   
 205  *********************************************************************
 206  * OBJECTIVE FUNCTION AND CONSTRAINTS
 207  *********************************************************************
 208   
 209  EQUATIONS
 210  OF            Objective function
 211  MATCHED_G     Matched generation to generation block coupling
 212  MATCHED_D     Matched demand to demand block coupling
 213  TOT_MATCHED_G Total matched generation
 214  TOT_MATCHED_D Total matched demand
 215  NODAL_MARKET  Market equilibrium at bus
 216  LPFE          Line power flow equations
 217  RAMP_D        Ramp down limit constraints
 218  RAMP_U        Ramp up limit constraints
 219  PGMIN         Minimum generation
 220  PGMAX         Maximum generation;
 221   
 222  * Social Welfare:
 223  OF.. SW =e=
 224  sum(t,
 225        sum(d, sum(bd, lbd(t,d,bd)*PD(t,d,bd)))
 226      - sum(g, sum(bg, lbg(t,g,bg)*PG(t,g,bg)))
 227     );
 228   
 229  * Matched generation to generation block coupling:
 230  MATCHED_G(t,g,bg).. PG(t,g,bg) =l= pbg(t,g,bg);
 231   
 232  * Matched demand to demand block coupling:
 233  MATCHED_D(t,d,bd).. PD(t,d,bd) =l= pbd(t,d,bd);
 234   
 235  * Total matched generation:
 236  TOT_MATCHED_G(t,g).. PGT(t,g) =e= sum(bg, PG(t,g,bg));
 237   
 238  * Total matched demand:
 239  TOT_MATCHED_D(t,d).. PDT(t,d) =e= sum(bd, PD(t,d,bd));
 240   
 241  * Market Equilibrium:
 242  NODAL_MARKET(t,b)..
 243  * Total power outflow to the grid:
 244    sum(b_d$l(b,b_d), P(t,b,b_d))
 245  * Total power inflow  from the grid:
 246  - sum(b_o$l(b_o,b), P(t,b_o,b))
 247  * Net power balance of bus "b":
 248  =e= sum(g$gb(g,b),PGT(t,g))- sum(d$db(d,b),PDT(t,d)) ;
 249   
 250  * Line power flow equations:
 251  LPFE(t,b_o,b_d)$l(b_o,b_d).. P(t,b_o,b_d) =e= pbase*(Th(t,b_o)-Th(t,b_d))/x(b_o,b_d);
 252   
 253  * Ramp down limit:
 254  RAMP_D(t0,g)$(ord(t0) gt 1).. PGT(t0,g) - PGT(t0-1,g) =g= -rd(g);
 255   
 256  * Ramp up limit:
 257  RAMP_U(t0,g)$(ord(t0) gt 1).. PGT(t0,g) - PGT(t0-1,g) =l= ru(g);
 258   
 259  * Generation limits:
 260  PGMIN(t,g)..  PGT(t,g) =g= pg_min(g)*U(t,g);
 261  PGMAX(t,g)..  PGT(t,g) =l= pg_max(g)*U(t,g);
 262   
 263  *********************************************************************
 264  * OPTIMIZATION
 265  *********************************************************************
 266   
 267  MODEL TCMPA    / ALL /;
 268  option optCR = 0.0;
 269  SOLVE TCMPA USING mip MAXIMIZING SW;
 270  U.fx(t,g) = U.l(t,g);
 271  SOLVE TCMPA USING rmip MAXIMIZING SW;
 272   
 273  *********************************************************************
 274  * MARKET CLEARING LOG
 275  *********************************************************************
 276   
 277  display NODAL_MARKET.m;
INCLUDE    C:\Users\citcea\Documents\GitHub\MUSAE\MUSAE_energy_markets\T2\TCMPA_withWPP\TCMPA_disp_equilibrium.gms
 279  ********************************************************************************
 280  * F.-Javier Heredia f.javier.heredia(at)upc.edu http://gnom.upc.edu/heredia
 281  * Code under Creative Commons Attribution-NonCommercial-NoDerivs
 282  * 3.0 Unported License http://creativecommons.org/licenses/by-nc-nd/3.0/
 283  ********************************************************************************
 284   
 285  SET cmat         Columns for tables "matched"      /bid_price, bid_power, matched_P/;
 286  SET ceq          Columns for "equilibrium" table   / 'price', 'energy', 'gen.', 'dem.', 'inflow', 'outflow',  'surp. gen.','surp. dem.', SW, 'surp. inf.', 'surp. out.', 'nodal SW'/;
 287  SET ceqt(ceq)    Columns for "equilibrium_T" table / 'energy', 'gen.', 'dem.', 'inflow', 'outflow',  'surp. gen.','surp. dem.', SW/;
 288  SET cmer         Columns for "merchandizing" table / 'price sell','price buy', 'energy', 'mer. surp.'/;
 289   
 290  PARAMETER
 291  matched_generation(t,g,bg,cmat), matched_demand(t,d,bd,cmat),
 292  market_equilibrium(t,b,ceq),
 293  market_equilibrium_T(t,ceqt),
 294  market_merchandizing(t,b,b,cmer);
 295   
 296  matched_generation(t,g,bg,'bid_price') = lbg(t,g,bg);
 297  matched_generation(t,g,bg,'bid_power') = pbg(t,g,bg);
 298  matched_demand(t,d,bd,'bid_price')     = lbd(t,d,bd);
 299  matched_demand(t,d,bd,'bid_power')     = pbd(t,d,bd);
 300   
 301  matched_generation(t,g,bg,'matched_P') = PG.l(t,g,bg);
 302  matched_demand(t,d,bd,'matched_P')     = PD.l(t,d,bd);
 303   
 304  *
 305  * Market equilibrium
 306  *
 307  loop(t,
 308   loop(b,
 309  *
 310  * Social Welfare
 311  *
 312    market_equilibrium(t,b,'surp. dem.') =
 313  * Demand and generation surplus:
 314    sum(d$db(d,b), sum(bd, (lbd(t, d, bd)-NODAL_MARKET.M(t,b))*PD.l(t,d,bd)));
 315    market_equilibrium(t,b,'surp. gen.') =
 316  * Demand and generation surplus:
 317   + sum(g$gb(g,b), sum(bg, (NODAL_MARKET.M(t,b)-lbg(t, g, bg))*PG.l(t,g,bg)));
 318    market_equilibrium(t,b,'SW') =
 319           market_equilibrium(t,b,'surp. dem.')
 320         + market_equilibrium(t,b,'surp. gen.');
 321  *
 322  * Nodal Equilibrium
 323  *
 324    market_equilibrium(t,b,'gen.')    = sum(g$gb(g,b), PGT.l(t,g));
 325    market_equilibrium(t,b,'dem.')    = sum(d$db(d,b), PDT.l(t,d));
 326    market_equilibrium(t,b,'inflow')  =
 327            sum(b_o$(l(b_o,b) and P.l(t,b_o,b)>0),P.l(t,b_o,b))
 328          - sum(b_d$(l(b,b_d) and P.l(t,b,b_d)<0),P.l(t,b,b_d));
 329    market_equilibrium(t,b,'surp. inf.')  =
 330            sum(b_o$(l(b_o,b) and P.l(t,b_o,b)>0), (NODAL_MARKET.M(t,b)-NODAL_MARKET.M(t,b_o))*P.l(t,b_o,b))
 331          - sum(b_d$(l(b,b_d) and P.l(t,b,b_d)<0), (NODAL_MARKET.M(t,b)-NODAL_MARKET.M(t,b_d))*P.l(t,b,b_d));
 332    market_equilibrium(t,b,'outflow') =
 333            sum(b_d$(l(b,b_d) and P.l(t,b,b_d)>0),P.l(t,b,b_d))
 334          - sum(b_o$(l(b_o,b) and P.l(t,b_o,b)<0),P.l(t,b_o,b));
 335    market_equilibrium(t,b,'surp. out.') =
 336            sum(b_d$(l(b,b_d) and P.l(t,b,b_d)>0), (NODAL_MARKET.M(t,b_d)-NODAL_MARKET.M(t,b))*P.l(t,b,b_d))
 337          - sum(b_o$(l(b_o,b) and P.l(t,b_o,b)<0), (NODAL_MARKET.M(t,b_o)-NODAL_MARKET.M(t,b))*P.l(t,b_o,b));
 338    market_equilibrium(t,b,'nodal SW') =   market_equilibrium(t,b,'SW')
 339                                         + market_equilibrium(t,b,'surp. inf.')
 340                                         + market_equilibrium(t,b,'surp. out.');
 341   
 342    market_equilibrium(t,b,'energy') =
 343           market_equilibrium(t,b,'gen.')
 344        +  market_equilibrium(t,b,'inflow');
 345    market_equilibrium(t,b,'price')  = NODAL_MARKET.m(t,b);
 346   );
 347  loop(ceqt, market_equilibrium_T(t,ceqt) = sum(b, market_equilibrium(t,b,ceqt)));
 348  );
 349  *
 350  * Merchandising surplus:
 351  *
 352  loop(t,
 353     loop(b_o,
 354        loop(b_d$(l(b_o,b_d) and P.l(t,b_o,b_d)>0),
 355  *     Positive outflow:
 356        market_merchandizing(t,b_o,b_d,'price buy') = NODAL_MARKET.m(t,b_o);
 357        market_merchandizing(t,b_o,b_d,'price sell')  = NODAL_MARKET.m(t,b_d);
 358        market_merchandizing(t,b_o,b_d,'energy')       = P.l(t,b_o,b_d);
 359        market_merchandizing(t,b_o,b_d,'mer. surp.') = (NODAL_MARKET.m(t,b_d)-NODAL_MARKET.m(t,b_o))*P.l(t,b_o,b_d);
 360        );
 361        loop(b_d$(l(b_o,b_d) and P.l(t,b_o,b_d)<0),
 362  *     Negative outflow (inflow):
 363        market_merchandizing(t,b_o,b_d,'price buy')  = NODAL_MARKET.m(t,b_d);
 364        market_merchandizing(t,b_o,b_d,'price sell') = NODAL_MARKET.m(t,b_o);
 365        market_merchandizing(t,b_o,b_d,'energy')     = -P.l(t,b_o,b_d);
 366        market_merchandizing(t,b_o,b_d,'mer. surp.') = (NODAL_MARKET.m(t,b_d)-NODAL_MARKET.m(t,b_o))*P.l(t,b_o,b_d);
 367        );
 368     );
 369  );
 370  display
 371  matched_generation, PGT.l,
 372  matched_demand    , PDT.l,
 373  market_equilibrium,
 374  market_equilibrium_T,
 375  market_merchandizing;
INCLUDE    C:\Users\citcea\Documents\GitHub\MUSAE\MUSAE_energy_markets\T2\TCMPA_withWPP\TCMPA_disp_equilibrium_bus.gms
 377  ********************************************************************************
 378  * F.-Javier Heredia f.javier.heredia(at)upc.edu http://gnom.upc.edu/heredia
 379  * Code under Creative Commons Attribution-NonCommercial-NoDerivs
 380  * 3.0 Unported License http://creativecommons.org/licenses/by-nc-nd/3.0/
 381  ********************************************************************************
 382   
 383  SET cmat_bus Columns for tables "matched"      /bid_price, bid_power, matched_P/;
 384  SET in /in/;
 385  SET ou /out/;
 386   
 387  PARAMETER
 388  matched_generation_bus(b,t,g,bg,cmat_bus)
 389  matched_demand_bus(b,t,d,bd,cmat_bus)
 390  matched_inflow_bus(b,t,b_o,in,cmat_bus)
 391  matched_outflow_bus(b,t,b_o,ou,cmat_bus);
 392  *
 393  * Generation units
 394  *
 395  matched_generation_bus(b,t,g,bg,'bid_price')$gb(g,b) = lbg(t,g,bg);
 396  matched_generation_bus(b,t,g,bg,'bid_power')$gb(g,b) = pbg(t,g,bg);
 397  matched_generation_bus(b,t,g,bg,'matched_P')$gb(g,b) = PG.l(t,g,bg);
 398  * Positive inflow (= generation unit):
 399  matched_inflow_bus(b,t,b_o,in,'bid_price')$(l(b_o,b) and P.l(t,b_o,b)>0) = NODAL_MARKET.m(t,b_o);
 400  matched_inflow_bus(b,t,b_o,in,'bid_power')$(l(b_o,b) and P.l(t,b_o,b)>0) = P.up(t,b_o,b);
 401  matched_inflow_bus(b,t,b_o,in,'matched_P')$(l(b_o,b) and P.l(t,b_o,b)>0) = P.l(t,b_o,b);
 402  * Negative outflow (= positive inflow = generation unit):
 403  matched_inflow_bus(b,t,b_d,in,'bid_price')$(l(b,b_d) and P.l(t,b,b_d)<0) = NODAL_MARKET.m(t,b_d);
 404  matched_inflow_bus(b,t,b_d,in,'bid_power')$(l(b,b_d) and P.l(t,b,b_d)<0) = P.up(t,b,b_d);
 405  matched_inflow_bus(b,t,b_d,in,'matched_P')$(l(b,b_d) and P.l(t,b,b_d)<0) = -P.l(t,b,b_d);
 406  *
 407  * Demand units
 408  *
 409  matched_demand_bus(b,t,d,bd,'bid_price')$db(d,b)     = lbd(t,d,bd);
 410  matched_demand_bus(b,t,d,bd,'bid_power')$db(d,b)     = pbd(t,d,bd);
 411  matched_demand_bus(b,t,d,bd,'matched_P')$db(d,b)     = PD.l(t,d,bd);
 412  * Positive outflow (= demand unit):
 413  matched_outflow_bus(b,t,b_d,ou,'bid_price')$(l(b,b_d) and P.l(t,b,b_d)>0) = NODAL_MARKET.m(t,b_d);
 414  matched_outflow_bus(b,t,b_d,ou,'bid_power')$(l(b,b_d) and P.l(t,b,b_d)>0) = P.up(t,b,b_d);
 415  matched_outflow_bus(b,t,b_d,ou,'matched_P')$(l(b,b_d) and P.l(t,b,b_d)>0) = P.l(t,b,b_d);
 416  * Negative inflow ( = positive outflow = demand unit):
 417  matched_outflow_bus(b,t,b_o,ou,'bid_price')$(l(b_o,b) and P.l(t,b_o,b)<0) = NODAL_MARKET.m(t,b_o);
 418  matched_outflow_bus(b,t,b_o,ou,'bid_power')$(l(b_o,b) and P.l(t,b_o,b)<0) = P.up(t,b_o,b);
 419  matched_outflow_bus(b,t,b_o,ou,'matched_P')$(l(b_o,b) and P.l(t,b_o,b)<0) = -P.l(t,b_o,b);
 420   
 421  display
 422  matched_generation_bus, matched_inflow_bus,
 423  matched_demand_bus,     matched_outflow_bus;
INCLUDE    C:\Users\citcea\Documents\GitHub\MUSAE\MUSAE_energy_markets\T2\TCMPA_withWPP\TCMPA_disp_settlement.gms
 425  ********************************************************************************
 426  * F.-Javier Heredia f.javier.heredia(at)upc.edu http://gnom.upc.edu/heredia
 427  * Code under Creative Commons Attribution-NonCommercial-NoDerivs
 428  * 3.0 Unported License http://creativecommons.org/licenses/by-nc-nd/3.0/
 429  ********************************************************************************
 430   
 431  *
 432  * Settlement
 433  *
 434  SET rsg  Rows for generation settlement  / Revenue, 'Total rev.', Surplus, 'Total sur.'/;
 435  SET rsd  Rows for demand settlement      / Payment, 'Total pay.', Surplus, 'Total sur.'/;
 436  PARAMETER
 437  settlementG(rsg, g, t),
 438  settlementD(rsd, d, t),
 439  settlementGT(rsg, t),
 440  settlementDT(rsd, t);
 441  loop(t,
 442           loop(g,
 443                   settlementG('Revenue',g,t) =
 444                           sum(b$gb(g,b),NODAL_MARKET.m(t,b)*PGT.l(t,g));
 445                   settlementG('Surplus',g,t) =
 446                           settlementG('Revenue',g,t) - sum(bg,lbg(t,g,bg)*PG.l(t,g,bg))
 447           );
 448           settlementGT('Total rev.',t) = sum(g,settlementG('Revenue',g,t));
 449           settlementGT('Total sur.',t) = sum(g,settlementG('Surplus',g,t));
 450           loop(d,
 451                   settlementD('Payment',d,t) =
 452                           sum(b$db(d,b),NODAL_MARKET.m(t,b)*PDT.l(t,d));
 453                   settlementD('Surplus',d,t) =
 454                           sum(bd,lbd(t,d,bd)*PD.l(t,d,bd))- settlementD('Payment',d,t)
 455           );
 456           settlementDT('Total pay.',t) = sum(d,settlementD('Payment',d,t));
 457           settlementDT('Total sur.',t) = sum(d,settlementD('Surplus',d,t));
 458  );
 459   
 460  display settlementG, settlementD, settlementGT, settlementDT;
 461   
