 460   
 461  file TCMPA_bus /TCMPA_bus.dat/;
 462  file TCMPA_eq  /TCMPA_eq.dat/;
 463  file TCMPA_lbg /TCMPA_lbg.dat/;
 464  file TCMPA_pbg /TCMPA_pbg.dat/;
 465  file TCMPA_PG  /TCMPA_PG.dat/;
 466  file TCMPA_lbd /TCMPA_lbd.dat/;
 467  file TCMPA_pbd /TCMPA_pbd.dat/;
 468  file TCMPA_PD  /TCMPA_PD.dat/;
 469   
 470  put TCMPA_bus; loop(bout, put bout.tl);
 471  put TCMPA_eq;
 472  scalar aux;
 473  loop(b$bout(b),
 474           loop(t,
 475                   put market_equilibrium(t,b,'energy');
 476                   put market_equilibrium(t,b,'price');
 477                   put market_equilibrium(t,b,'nodal SW');
 478                   put /
 479           );
 480  );
 481   
 482  loop(b$bout(b),
 483  put TCMPA_lbg;
 484  loop(t,
 485           loop(g$gb(g,b), loop(bg, put  lbg(t,g,bg)));
 486  *        Positive Inflow => generation unit
 487           loop(b_o$(l(b_o,b) and P.l(t,b_o,b)>0), put NODAL_MARKET.m(t,b_o));
 488  *        Negative Outflow => generation unit
 489           loop(b_d$(l(b,b_d) and P.l(t,b,b_d)<0), put NODAL_MARKET.m(t,b_d));
 490           put /);
 491  put TCMPA_pbg;
 492  loop(t,
 493           loop(g$gb(g,b), loop(bg, put  pbg(t,g,bg)));
 494  *        Positive Inflow => generation unit
 495           loop(b_o$(l(b_o,b) and P.l(t,b_o,b)>0), put  P.up(t,b_o,b));
 496  *        Negative Outflow => generation unit
 497           loop(b_d$(l(b,b_d) and P.l(t,b,b_d)<0), aux = -P.lo(t,b,b_d); put aux);
 498           put /);
 499  put TCMPA_PG;
 500  loop(t,
 501           loop(g$gb(g,b), loop(bg, put PG.l(t,g,bg)));
 502  *        Positive Inflow => generation unit
 503           loop(b_o$(l(b_o,b) and P.l(t,b_o,b)>0), put  P.l(t,b_o,b));
 504  *        Negative Outflow => generation unit
 505           loop(b_d$(l(b,b_d) and P.l(t,b,b_d)<0), aux = -P.l(t,b,b_d); put aux);
 506           put /);
 507  put TCMPA_lbd;
 508  loop(t,
 509           loop(d$db(d,b), loop(bd, put  lbd(t,d,bd)));
 510  *        Negative Inflow => demand unit
 511           loop(b_o$(l(b_o,b) and P.l(t,b_o,b)<0), put NODAL_MARKET.m(t,b_o));
 512  *        Positive Outflow => demand unit
 513           loop(b_d$(l(b,b_d) and P.l(t,b,b_d)>0), put NODAL_MARKET.m(t,b_d));
 514           put /);
 515  put TCMPA_pbd;
 516  loop(t,
 517           loop(d$db(d,b), loop(bd, put  pbd(t,d,bd)));
 518  *        Negative Inflow => demand unit
 519           loop(b_o$(l(b_o,b) and P.l(t,b_o,b)<0), aux = -P.lo(t,b_o,b); put aux);
 520  *        Positive Outflow => demand unit
 521           loop(b_d$(l(b,b_d) and P.l(t,b,b_d)>0), put  P.up(t,b,b_d));
 522           put /);
 523  put TCMPA_PD;
 524  loop(t,
 525           loop(d$db(d,b), loop(bd, put PD.l(t,d,bd)));
 526  *        Negative Inflow => demand unit
 527           loop(b_o$(l(b_o,b) and P.l(t,b_o,b)<0), aux = -P.l(t,b_o,b); put aux);
 528  *        Positive Outflow => demand unit
 529           loop(b_d$(l(b,b_d) and P.l(t,b,b_d)>0), put  P.l(t,b,b_d));
 530           put /);
 531  );
 532   
 533  *file TCMPA_PGT   /TCMPA_PGT.dat/;
 534  *file TCMPA_PGmin /TCMPA_PGmin.dat/;
 535  *file TCMPA_PGmax /TCMPA_PGmax.dat/;
 536  *file TCMPA_PGRU  /TCMPA_PGRU.dat/;
 537  *file TCMPA_PGRD  /TCMPA_PGRD.dat/;
 538   
 539  *put TCMPA_PGT;
 540  *loop(g,
 541  *loop(t0, put PGT.l(t0,g)); put/;
 542  *loop(t0, put pg_min(g)) ; put/;
 543  *loop(t0, put pg_max(g)) ; put/;
 544  *loop(t0, put rd(g))     ; put/;
 545  *loop(t0, put ru(g))     ; put/;
 546  *);
