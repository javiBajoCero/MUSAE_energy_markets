 148  display gb, db, refb, l;
 149   
 150  PARAMETERS pbase basepower [MVAr] / 100 /;
 151  TABLE x(b,b) Line reactance [p.u.]
 152        bus1 bus2   bus3  bus4
 153  bus1   0.0  0.058 0.04  0.0
 154  bus2   0.0  0.0   0.08  0.08
 155  bus3   0.0  0.0   0.0   0.12
 156  bus4   0.0  0.0   0.0   0.0  ;
 157   
 158  TABLE s_max(b,b) Line capacity [MVA]
 159         bus1 bus2 bus3  bus4
 160  bus1   150  150  150   150
 161  bus2   150  150  150   150
 162  bus3   150  150  150   150
 163  bus4   150  150  150   150  ;
 164   
 165  *********************************************************************
 166  * VARIABLES
 167  *********************************************************************
 168   
 169  FREE VARIABLE     SW         Social welfare (objective function);
 170  * Generation;
 171  POSITIVE VARIABLE PG(t,g,bg) Matched generation of each block [MW]
 172                    PGT(t0,g)  Total matched generation [MW]
 173  BINARY VARIABLE   U(t,g)     on-off state of the unit;
 174  * Total generation at t=0:
 175  PGT.fx('t0',g) = p0(g);
 176   
 177  * Demand;
 178  POSITIVE VARIABLE PD(t,d,bd) Matched demand of each block [MW]
 179                    PDT(t,d)   Total matched demand [MW];
 180  * Grid;
 181  VARIABLE P(t,b,b)   Line power [MW]
 182           Th(t,b)    Voltage phase;
 183   
 184  P.fx(t,b_o,b_d)$(not l(b_o,b_d)) = 0.0;
 185  P.lo(t,b_o,b_d)   = -s_max(b_o,b_d);
 186  P.up(t,b_o,b_d)   = s_max(b_o,b_d);
 187   
 188  Th.fx(t,refb) = 0.0;
 189   
 190  *********************************************************************
 191  * OBJECTIVE FUNCTION AND CONSTRAINTS
 192  *********************************************************************
 193   
 194  EQUATIONS
 195  OF            Objective function
 196  MATCHED_G     Matched generation to generation block coupling
 197  MATCHED_D     Matched demand to demand block coupling
 198  TOT_MATCHED_G Total matched generation
 199  TOT_MATCHED_D Total matched demand
 200  NODAL_MARKET  Market equilibrium at bus
 201  LPFE          Line power flow equations
 202  RAMP_D        Ramp down limit constraints
 203  RAMP_U        Ramp up limit constraints
 204  PGMIN         Minimum generation
 205  PGMAX         Maximum generation;
 206   
 207  * Social Welfare:
 208  OF.. SW =e=
 209  sum(t,
 210        sum(d, sum(bd, lbd(t,d,bd)*PD(t,d,bd)))
 211      - sum(g, sum(bg, lbg(t,g,bg)*PG(t,g,bg)))
 212     );
 213   
 214  * Matched generation to generation block coupling:
 215  MATCHED_G(t,g,bg).. PG(t,g,bg) =l= pbg(t,g,bg);
 216   
 217  * Matched demand to demand block coupling:
 218  MATCHED_D(t,d,bd).. PD(t,d,bd) =l= pbd(t,d,bd);
 219   
 220  * Total matched generation:
 221  TOT_MATCHED_G(t,g).. PGT(t,g) =e= sum(bg, PG(t,g,bg));
 222   
 223  * Total matched demand:
 224  TOT_MATCHED_D(t,d).. PDT(t,d) =e= sum(bd, PD(t,d,bd));
 225   
 226  * Market Equilibrium:
 227  NODAL_MARKET(t,b)..
 228  * Total power outflow to the grid:
 229    sum(b_d$l(b,b_d), P(t,b,b_d))
 230  * Total power inflow  from the grid:
 231  - sum(b_o$l(b_o,b), P(t,b_o,b))
 232  * Net power balance of bus "b":
 233  =e= sum(g$gb(g,b),PGT(t,g))- sum(d$db(d,b),PDT(t,d)) ;
 234   
 235  * Line power flow equations:
 236  LPFE(t,b_o,b_d)$l(b_o,b_d).. P(t,b_o,b_d) =e= pbase*(Th(t,b_o)-Th(t,b_d))/x(b_o,b_d);
 237   
 238  * Ramp down limit:
 239  RAMP_D(t0,g)$(ord(t0) gt 1).. PGT(t0,g) - PGT(t0-1,g) =g= -rd(g);
 240   
 241  * Ramp up limit:
 242  RAMP_U(t0,g)$(ord(t0) gt 1).. PGT(t0,g) - PGT(t0-1,g) =l= ru(g);
 243   
 244  * Generation limits:
 245  PGMIN(t,g)..  PGT(t,g) =g= pg_min(g)*U(t,g);
 246  PGMAX(t,g)..  PGT(t,g) =l= pg_max(g)*U(t,g);
 247   
 248  *********************************************************************
 249  * OPTIMIZATION
 250  *********************************************************************
 251   
 252  MODEL TCMPA    / ALL /;
 253  option optCR = 0.0;
 254  SOLVE TCMPA USING mip MAXIMIZING SW;
 255  U.fx(t,g) = U.l(t,g);
 256  SOLVE TCMPA USING rmip MAXIMIZING SW;
 257   
 258  *********************************************************************
 259  * MARKET CLEARING LOG
 260  *********************************************************************
 261   
 262  display NODAL_MARKET.m;
INCLUDE    C:\Users\citcea\Documents\GitHub\MUSAE\MUSAE_energy_markets\T2\TCMPA\TCMPA_disp_equilibrium.gms
 264  ********************************************************************************
 265  * F.-Javier Heredia f.javier.heredia(at)upc.edu http://gnom.upc.edu/heredia
 266  * Code under Creative Commons Attribution-NonCommercial-NoDerivs
 267  * 3.0 Unported License http://creativecommons.org/licenses/by-nc-nd/3.0/
 268  ********************************************************************************
 269   
 270  SET cmat         Columns for tables "matched"      /bid_price, bid_power, matched_P/;
 271  SET ceq          Columns for "equilibrium" table   / 'price', 'energy', 'gen.', 'dem.', 'inflow', 'outflow',  'surp. gen.','surp. dem.', SW, 'surp. inf.', 'surp. out.', 'nodal SW'/;
 272  SET ceqt(ceq)    Columns for "equilibrium_T" table / 'energy', 'gen.', 'dem.', 'inflow', 'outflow',  'surp. gen.','surp. dem.', SW/;
 273  SET cmer         Columns for "merchandizing" table / 'price sell','price buy', 'energy', 'mer. surp.'/;
 274   
 275  PARAMETER
 276  matched_generation(t,g,bg,cmat), matched_demand(t,d,bd,cmat),
 277  market_equilibrium(t,b,ceq),
 278  market_equilibrium_T(t,ceqt),
 279  market_merchandizing(t,b,b,cmer);
 280   
 281  matched_generation(t,g,bg,'bid_price') = lbg(t,g,bg);
 282  matched_generation(t,g,bg,'bid_power') = pbg(t,g,bg);
 283  matched_demand(t,d,bd,'bid_price')     = lbd(t,d,bd);
 284  matched_demand(t,d,bd,'bid_power')     = pbd(t,d,bd);
 285   
 286  matched_generation(t,g,bg,'matched_P') = PG.l(t,g,bg);
 287  matched_demand(t,d,bd,'matched_P')     = PD.l(t,d,bd);
 288   
 289  *
 290  * Market equilibrium
 291  *
 292  loop(t,
 293   loop(b,
 294  *
 295  * Social Welfare
 296  *
 297    market_equilibrium(t,b,'surp. dem.') =
 298  * Demand and generation surplus:
 299    sum(d$db(d,b), sum(bd, (lbd(t, d, bd)-NODAL_MARKET.M(t,b))*PD.l(t,d,bd)));
 300    market_equilibrium(t,b,'surp. gen.') =
 301  * Demand and generation surplus:
 302   + sum(g$gb(g,b), sum(bg, (NODAL_MARKET.M(t,b)-lbg(t, g, bg))*PG.l(t,g,bg)));
 303    market_equilibrium(t,b,'SW') =
 304           market_equilibrium(t,b,'surp. dem.')
 305         + market_equilibrium(t,b,'surp. gen.');
 306  *
 307  * Nodal Equilibrium
 308  *
 309    market_equilibrium(t,b,'gen.')    = sum(g$gb(g,b), PGT.l(t,g));
 310    market_equilibrium(t,b,'dem.')    = sum(d$db(d,b), PDT.l(t,d));
 311    market_equilibrium(t,b,'inflow')  =
 312            sum(b_o$(l(b_o,b) and P.l(t,b_o,b)>0),P.l(t,b_o,b))
 313          - sum(b_d$(l(b,b_d) and P.l(t,b,b_d)<0),P.l(t,b,b_d));
 314    market_equilibrium(t,b,'surp. inf.')  =
 315            sum(b_o$(l(b_o,b) and P.l(t,b_o,b)>0), (NODAL_MARKET.M(t,b)-NODAL_MARKET.M(t,b_o))*P.l(t,b_o,b))
 316          - sum(b_d$(l(b,b_d) and P.l(t,b,b_d)<0), (NODAL_MARKET.M(t,b)-NODAL_MARKET.M(t,b_d))*P.l(t,b,b_d));
 317    market_equilibrium(t,b,'outflow') =
 318            sum(b_d$(l(b,b_d) and P.l(t,b,b_d)>0),P.l(t,b,b_d))
 319          - sum(b_o$(l(b_o,b) and P.l(t,b_o,b)<0),P.l(t,b_o,b));
 320    market_equilibrium(t,b,'surp. out.') =
 321            sum(b_d$(l(b,b_d) and P.l(t,b,b_d)>0), (NODAL_MARKET.M(t,b_d)-NODAL_MARKET.M(t,b))*P.l(t,b,b_d))
 322          - sum(b_o$(l(b_o,b) and P.l(t,b_o,b)<0), (NODAL_MARKET.M(t,b_o)-NODAL_MARKET.M(t,b))*P.l(t,b_o,b));
 323    market_equilibrium(t,b,'nodal SW') =   market_equilibrium(t,b,'SW')
 324                                         + market_equilibrium(t,b,'surp. inf.')
 325                                         + market_equilibrium(t,b,'surp. out.');
 326   
 327    market_equilibrium(t,b,'energy') =
 328           market_equilibrium(t,b,'gen.')
 329        +  market_equilibrium(t,b,'inflow');
 330    market_equilibrium(t,b,'price')  = NODAL_MARKET.m(t,b);
 331   );
 332  loop(ceqt, market_equilibrium_T(t,ceqt) = sum(b, market_equilibrium(t,b,ceqt)));
 333  );
 334  *
 335  * Merchandising surplus:
 336  *
 337  loop(t,
 338     loop(b_o,
 339        loop(b_d$(l(b_o,b_d) and P.l(t,b_o,b_d)>0),
 340  *     Positive outflow:
 341        market_merchandizing(t,b_o,b_d,'price buy') = NODAL_MARKET.m(t,b_o);
 342        market_merchandizing(t,b_o,b_d,'price sell')  = NODAL_MARKET.m(t,b_d);
 343        market_merchandizing(t,b_o,b_d,'energy')       = P.l(t,b_o,b_d);
 344        market_merchandizing(t,b_o,b_d,'mer. surp.') = (NODAL_MARKET.m(t,b_d)-NODAL_MARKET.m(t,b_o))*P.l(t,b_o,b_d);
 345        );
 346        loop(b_d$(l(b_o,b_d) and P.l(t,b_o,b_d)<0),
 347  *     Negative outflow (inflow):
 348        market_merchandizing(t,b_o,b_d,'price buy')  = NODAL_MARKET.m(t,b_d);
 349        market_merchandizing(t,b_o,b_d,'price sell') = NODAL_MARKET.m(t,b_o);
 350        market_merchandizing(t,b_o,b_d,'energy')     = -P.l(t,b_o,b_d);
 351        market_merchandizing(t,b_o,b_d,'mer. surp.') = (NODAL_MARKET.m(t,b_d)-NODAL_MARKET.m(t,b_o))*P.l(t,b_o,b_d);
 352        );
 353     );
 354  );
 355  display
 356  matched_generation, PGT.l,
 357  matched_demand    , PDT.l,
 358  market_equilibrium,
 359  market_equilibrium_T,
 360  market_merchandizing;
INCLUDE    C:\Users\citcea\Documents\GitHub\MUSAE\MUSAE_energy_markets\T2\TCMPA\TCMPA_disp_equilibrium_bus.gms
 362  ********************************************************************************
 363  * F.-Javier Heredia f.javier.heredia(at)upc.edu http://gnom.upc.edu/heredia
 364  * Code under Creative Commons Attribution-NonCommercial-NoDerivs
 365  * 3.0 Unported License http://creativecommons.org/licenses/by-nc-nd/3.0/
 366  ********************************************************************************
 367   
 368  SET cmat_bus Columns for tables "matched"      /bid_price, bid_power, matched_P/;
 369  SET in /in/;
 370  SET ou /out/;
 371   
 372  PARAMETER
 373  matched_generation_bus(b,t,g,bg,cmat_bus)
 374  matched_demand_bus(b,t,d,bd,cmat_bus)
 375  matched_inflow_bus(b,t,b_o,in,cmat_bus)
 376  matched_outflow_bus(b,t,b_o,ou,cmat_bus);
 377  *
 378  * Generation units
 379  *
 380  matched_generation_bus(b,t,g,bg,'bid_price')$gb(g,b) = lbg(t,g,bg);
 381  matched_generation_bus(b,t,g,bg,'bid_power')$gb(g,b) = pbg(t,g,bg);
 382  matched_generation_bus(b,t,g,bg,'matched_P')$gb(g,b) = PG.l(t,g,bg);
 383  * Positive inflow (= generation unit):
 384  matched_inflow_bus(b,t,b_o,in,'bid_price')$(l(b_o,b) and P.l(t,b_o,b)>0) = NODAL_MARKET.m(t,b_o);
 385  matched_inflow_bus(b,t,b_o,in,'bid_power')$(l(b_o,b) and P.l(t,b_o,b)>0) = P.up(t,b_o,b);
 386  matched_inflow_bus(b,t,b_o,in,'matched_P')$(l(b_o,b) and P.l(t,b_o,b)>0) = P.l(t,b_o,b);
 387  * Negative outflow (= positive inflow = generation unit):
 388  matched_inflow_bus(b,t,b_d,in,'bid_price')$(l(b,b_d) and P.l(t,b,b_d)<0) = NODAL_MARKET.m(t,b_d);
 389  matched_inflow_bus(b,t,b_d,in,'bid_power')$(l(b,b_d) and P.l(t,b,b_d)<0) = P.up(t,b,b_d);
 390  matched_inflow_bus(b,t,b_d,in,'matched_P')$(l(b,b_d) and P.l(t,b,b_d)<0) = -P.l(t,b,b_d);
 391  *
 392  * Demand units
 393  *
 394  matched_demand_bus(b,t,d,bd,'bid_price')$db(d,b)     = lbd(t,d,bd);
 395  matched_demand_bus(b,t,d,bd,'bid_power')$db(d,b)     = pbd(t,d,bd);
 396  matched_demand_bus(b,t,d,bd,'matched_P')$db(d,b)     = PD.l(t,d,bd);
 397  * Positive outflow (= demand unit):
 398  matched_outflow_bus(b,t,b_d,ou,'bid_price')$(l(b,b_d) and P.l(t,b,b_d)>0) = NODAL_MARKET.m(t,b_d);
 399  matched_outflow_bus(b,t,b_d,ou,'bid_power')$(l(b,b_d) and P.l(t,b,b_d)>0) = P.up(t,b,b_d);
 400  matched_outflow_bus(b,t,b_d,ou,'matched_P')$(l(b,b_d) and P.l(t,b,b_d)>0) = P.l(t,b,b_d);
 401  * Negative inflow ( = positive outflow = demand unit):
 402  matched_outflow_bus(b,t,b_o,ou,'bid_price')$(l(b_o,b) and P.l(t,b_o,b)<0) = NODAL_MARKET.m(t,b_o);
 403  matched_outflow_bus(b,t,b_o,ou,'bid_power')$(l(b_o,b) and P.l(t,b_o,b)<0) = P.up(t,b_o,b);
 404  matched_outflow_bus(b,t,b_o,ou,'matched_P')$(l(b_o,b) and P.l(t,b_o,b)<0) = -P.l(t,b_o,b);
 405   
 406  display
 407  matched_generation_bus, matched_inflow_bus,
 408  matched_demand_bus,     matched_outflow_bus;
INCLUDE    C:\Users\citcea\Documents\GitHub\MUSAE\MUSAE_energy_markets\T2\TCMPA\TCMPA_disp_settlement.gms
 410  ********************************************************************************
 411  * F.-Javier Heredia f.javier.heredia(at)upc.edu http://gnom.upc.edu/heredia
 412  * Code under Creative Commons Attribution-NonCommercial-NoDerivs
 413  * 3.0 Unported License http://creativecommons.org/licenses/by-nc-nd/3.0/
 414  ********************************************************************************
 415   
 416  *
 417  * Settlement
 418  *
 419  SET rsg  Rows for generation settlement  / Revenue, 'Total rev.', Surplus, 'Total sur.'/;
 420  SET rsd  Rows for demand settlement      / Payment, 'Total pay.', Surplus, 'Total sur.'/;
 421  PARAMETER
 422  settlementG(rsg, g, t),
 423  settlementD(rsd, d, t),
 424  settlementGT(rsg, t),
 425  settlementDT(rsd, t);
 426  loop(t,
 427           loop(g,
 428                   settlementG('Revenue',g,t) =
 429                           sum(b$gb(g,b),NODAL_MARKET.m(t,b)*PGT.l(t,g));
 430                   settlementG('Surplus',g,t) =
 431                           settlementG('Revenue',g,t) - sum(bg,lbg(t,g,bg)*PG.l(t,g,bg))
 432           );
 433           settlementGT('Total rev.',t) = sum(g,settlementG('Revenue',g,t));
 434           settlementGT('Total sur.',t) = sum(g,settlementG('Surplus',g,t));
 435           loop(d,
 436                   settlementD('Payment',d,t) =
 437                           sum(b$db(d,b),NODAL_MARKET.m(t,b)*PDT.l(t,d));
 438                   settlementD('Surplus',d,t) =
 439                           sum(bd,lbd(t,d,bd)*PD.l(t,d,bd))- settlementD('Payment',d,t)
 440           );
 441           settlementDT('Total pay.',t) = sum(d,settlementD('Payment',d,t));
 442           settlementDT('Total sur.',t) = sum(d,settlementD('Surplus',d,t));
 443  );
 444   
 445  display settlementG, settlementD, settlementGT, settlementDT;
