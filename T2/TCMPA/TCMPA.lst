 134   
 135  * Buses:
 136   
 137  SET  b      Buses            / bus1*bus4 /;
 138  SET refb(b) Reference bus    / bus1 /;
 139  alias(b,b_o,b_d);
 140   
 141  SET gb(g,b) Generation buses / G1.bus1, G2.bus1, G3.bus2, G4.bus2, G5.bus4 /;
 142  SET db(d,b) Demand buses     / D1.bus1, D2.bus2, D3.bus3 /;
 143   
 144  * Lines;
