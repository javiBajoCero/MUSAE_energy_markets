 168  bus4   150  150  150   150  ;
 169   
 170  *********************************************************************
 171  * VARIABLES
 172  *********************************************************************
 173   
 174  FREE VARIABLE     SW         Social welfare (objective function);
 175  * Generation;
 176  POSITIVE VARIABLE PG(t,g,bg) Matched generation of each block [MW]
 177                    PGT(t0,g)  Total matched generation [MW]
 178  BINARY VARIABLE   U(t,g)     on-off state of the unit;
 179  * Total generation at t=0:
 180  PGT.fx('t0',g) = p0(g);
 181   
 182  * Demand;
 183  POSITIVE VARIABLE PD(t,d,bd) Matched demand of each block [MW]
 184                    PDT(t,d)   Total matched demand [MW];
 185  * Grid;
 186  VARIABLE P(t,b,b)   Line power [MW]
 187           Th(t,b)    Voltage phase;
 188   
 189  P.fx(t,b_o,b_d)$(not l(b_o,b_d)) = 0.0;
 190  P.lo(t,b_o,b_d)   = -s_max(b_o,b_d);
 191  P.up(t,b_o,b_d)   = s_max(b_o,b_d);
 192   
 193  Th.fx(t,refb) = 0.0;
 194   
 195  *********************************************************************
 196  * OBJECTIVE FUNCTION AND CONSTRAINTS
 197  *********************************************************************
 198   
 199  EQUATIONS
 200  OF            Objective function
 201  MATCHED_G     Matched generation to generation block coupling
 202  MATCHED_D     Matched demand to demand block coupling
 203  TOT_MATCHED_G Total matched generation
 204  TOT_MATCHED_D Total matched demand
 205  NODAL_MARKET  Market equilibrium at bus
 206  LPFE          Line power flow equations
 207  RAMP_D        Ramp down limit constraints
 208  RAMP_U        Ramp up limit constraints
 209  PGMIN         Minimum generation
 210  PGMAX         Maximum generation;
 211   
 212  * Social Welfare:
 213  OF.. SW =e=
 214  sum(t,
 215        sum(d, sum(bd, lbd(t,d,bd)*PD(t,d,bd)))
 216      - sum(g, sum(bg, lbg(t,g,bg)*PG(t,g,bg)))
 217     );
 218   
 219  * Matched generation to generation block coupling:
 220  MATCHED_G(t,g,bg).. PG(t,g,bg) =l= pbg(t,g,bg);
 221   
 222  * Matched demand to demand block coupling:
 223  MATCHED_D(t,d,bd).. PD(t,d,bd) =l= pbd(t,d,bd);
 224   
 225  * Total matched generation:
 226  TOT_MATCHED_G(t,g).. PGT(t,g) =e= sum(bg, PG(t,g,bg));
 227   
 228  * Total matched demand:
 229  TOT_MATCHED_D(t,d).. PDT(t,d) =e= sum(bd, PD(t,d,bd));
 230   
 231  * Market Equilibrium:
 232  NODAL_MARKET(t,b)..
 233  * Total power outflow to the grid:
 234    sum(b_d$l(b,b_d), P(t,b,b_d))
 235  * Total power inflow  from the grid:
 236  - sum(b_o$l(b_o,b), P(t,b_o,b))
 237  * Net power balance of bus "b":
 238  =e= sum(g$gb(g,b),PGT(t,g))- sum(d$db(d,b),PDT(t,d)) ;
 239   
 240  * Line power flow equations:
 241  LPFE(t,b_o,b_d)$l(b_o,b_d).. P(t,b_o,b_d) =e= pbase*(Th(t,b_o)-Th(t,b_d))/x(b_o,b_d);
 242   
 243  * Ramp down limit:
 244  RAMP_D(t0,g)$(ord(t0) gt 1).. PGT(t0,g) - PGT(t0-1,g) =g= -rd(g);
 245   
 246  * Ramp up limit:
 247  RAMP_U(t0,g)$(ord(t0) gt 1).. PGT(t0,g) - PGT(t0-1,g) =l= ru(g);
 248   
 249  * Generation limits:
 250  PGMIN(t,g)..  PGT(t,g) =g= pg_min(g)*U(t,g);
 251  PGMAX(t,g)..  PGT(t,g) =l= pg_max(g)*U(t,g);
 252   
 253  *********************************************************************
 254  * OPTIMIZATION
 255  *********************************************************************
 256   
 257  MODEL TCMPA    / ALL /;
 258  option optCR = 0.0;
 259  SOLVE TCMPA USING mip MAXIMIZING SW;
 260  U.fx(t,g) = U.l(t,g);
 261  SOLVE TCMPA USING rmip MAXIMIZING SW;
 262   
 263  *********************************************************************
 264  * MARKET CLEARING LOG
 265  *********************************************************************
 266   
 267  display NODAL_MARKET.m;
INCLUDE    C:\Users\PC\Desktop\UPC\Energy Markets\GAMS files for MCM\TCMPA\TCMPA_disp_equilibrium.gms
 269  ********************************************************************************
 270  * F.-Javier Heredia f.javier.heredia(at)upc.edu http://gnom.upc.edu/heredia
 271  * Code under Creative Commons Attribution-NonCommercial-NoDerivs
 272  * 3.0 Unported License http://creativecommons.org/licenses/by-nc-nd/3.0/
 273  ********************************************************************************
 274   
 275  SET cmat         Columns for tables "matched"      /bid_price, bid_power, matched_P/;
 276  SET ceq          Columns for "equilibrium" table   / 'price', 'energy', 'gen.', 'dem.', 'inflow', 'outflow',  'surp. gen.','surp. dem.', SW, 'surp. inf.', 'surp. out.', 'nodal SW'/;
 277  SET ceqt(ceq)    Columns for "equilibrium_T" table / 'energy', 'gen.', 'dem.', 'inflow', 'outflow',  'surp. gen.','surp. dem.', SW/;
 278  SET cmer         Columns for "merchandizing" table / 'price sell','price buy', 'energy', 'mer. surp.'/;
 279   
 280  PARAMETER
 281  matched_generation(t,g,bg,cmat), matched_demand(t,d,bd,cmat),
 282  market_equilibrium(t,b,ceq),
 283  market_equilibrium_T(t,ceqt),
 284  market_merchandizing(t,b,b,cmer);
 285   
 286  matched_generation(t,g,bg,'bid_price') = lbg(t,g,bg);
 287  matched_generation(t,g,bg,'bid_power') = pbg(t,g,bg);
 288  matched_demand(t,d,bd,'bid_price')     = lbd(t,d,bd);
 289  matched_demand(t,d,bd,'bid_power')     = pbd(t,d,bd);
 290   
 291  matched_generation(t,g,bg,'matched_P') = PG.l(t,g,bg);
 292  matched_demand(t,d,bd,'matched_P')     = PD.l(t,d,bd);
 293   
 294  *
 295  * Market equilibrium
 296  *
 297  loop(t,
 298   loop(b,
 299  *
 300  * Social Welfare
 301  *
 302    market_equilibrium(t,b,'surp. dem.') =
 303  * Demand and generation surplus:
 304    sum(d$db(d,b), sum(bd, (lbd(t, d, bd)-NODAL_MARKET.M(t,b))*PD.l(t,d,bd)));
 305    market_equilibrium(t,b,'surp. gen.') =
 306  * Demand and generation surplus:
 307   + sum(g$gb(g,b), sum(bg, (NODAL_MARKET.M(t,b)-lbg(t, g, bg))*PG.l(t,g,bg)));
 308    market_equilibrium(t,b,'SW') =
 309           market_equilibrium(t,b,'surp. dem.')
 310         + market_equilibrium(t,b,'surp. gen.');
 311  *
 312  * Nodal Equilibrium
 313  *
 314    market_equilibrium(t,b,'gen.')    = sum(g$gb(g,b), PGT.l(t,g));
 315    market_equilibrium(t,b,'dem.')    = sum(d$db(d,b), PDT.l(t,d));
 316    market_equilibrium(t,b,'inflow')  =
 317            sum(b_o$(l(b_o,b) and P.l(t,b_o,b)>0),P.l(t,b_o,b))
 318          - sum(b_d$(l(b,b_d) and P.l(t,b,b_d)<0),P.l(t,b,b_d));
 319    market_equilibrium(t,b,'surp. inf.')  =
 320            sum(b_o$(l(b_o,b) and P.l(t,b_o,b)>0), (NODAL_MARKET.M(t,b)-NODAL_MARKET.M(t,b_o))*P.l(t,b_o,b))
 321          - sum(b_d$(l(b,b_d) and P.l(t,b,b_d)<0), (NODAL_MARKET.M(t,b)-NODAL_MARKET.M(t,b_d))*P.l(t,b,b_d));
 322    market_equilibrium(t,b,'outflow') =
 323            sum(b_d$(l(b,b_d) and P.l(t,b,b_d)>0),P.l(t,b,b_d))
 324          - sum(b_o$(l(b_o,b) and P.l(t,b_o,b)<0),P.l(t,b_o,b));
 325    market_equilibrium(t,b,'surp. out.') =
 326            sum(b_d$(l(b,b_d) and P.l(t,b,b_d)>0), (NODAL_MARKET.M(t,b_d)-NODAL_MARKET.M(t,b))*P.l(t,b,b_d))
 327          - sum(b_o$(l(b_o,b) and P.l(t,b_o,b)<0), (NODAL_MARKET.M(t,b_o)-NODAL_MARKET.M(t,b))*P.l(t,b_o,b));
 328    market_equilibrium(t,b,'nodal SW') =   market_equilibrium(t,b,'SW')
 329                                         + market_equilibrium(t,b,'surp. inf.')
 330                                         + market_equilibrium(t,b,'surp. out.');
 331   
 332    market_equilibrium(t,b,'energy') =
 333           market_equilibrium(t,b,'gen.')
 334        +  market_equilibrium(t,b,'inflow');
 335    market_equilibrium(t,b,'price')  = NODAL_MARKET.m(t,b);
 336   );
 337  loop(ceqt, market_equilibrium_T(t,ceqt) = sum(b, market_equilibrium(t,b,ceqt)));
 338  );
 339  *
 340  * Merchandising surplus:
 341  *
 342  loop(t,
 343     loop(b_o,
 344        loop(b_d$(l(b_o,b_d) and P.l(t,b_o,b_d)>0),
 345  *     Positive outflow:
 346        market_merchandizing(t,b_o,b_d,'price buy') = NODAL_MARKET.m(t,b_o);
 347        market_merchandizing(t,b_o,b_d,'price sell')  = NODAL_MARKET.m(t,b_d);
 348        market_merchandizing(t,b_o,b_d,'energy')       = P.l(t,b_o,b_d);
 349        market_merchandizing(t,b_o,b_d,'mer. surp.') = (NODAL_MARKET.m(t,b_d)-NODAL_MARKET.m(t,b_o))*P.l(t,b_o,b_d);
 350        );
 351        loop(b_d$(l(b_o,b_d) and P.l(t,b_o,b_d)<0),
 352  *     Negative outflow (inflow):
 353        market_merchandizing(t,b_o,b_d,'price buy')  = NODAL_MARKET.m(t,b_d);
 354        market_merchandizing(t,b_o,b_d,'price sell') = NODAL_MARKET.m(t,b_o);
 355        market_merchandizing(t,b_o,b_d,'energy')     = -P.l(t,b_o,b_d);
 356        market_merchandizing(t,b_o,b_d,'mer. surp.') = (NODAL_MARKET.m(t,b_d)-NODAL_MARKET.m(t,b_o))*P.l(t,b_o,b_d);
 357        );
 358     );
 359  );
 360  display
 361  matched_generation, PGT.l,
 362  matched_demand    , PDT.l,
 363  market_equilibrium,
 364  market_equilibrium_T,
 365  market_merchandizing;
INCLUDE    C:\Users\PC\Desktop\UPC\Energy Markets\GAMS files for MCM\TCMPA\TCMPA_disp_equilibrium_bus.gms
 367  ********************************************************************************
 368  * F.-Javier Heredia f.javier.heredia(at)upc.edu http://gnom.upc.edu/heredia
 369  * Code under Creative Commons Attribution-NonCommercial-NoDerivs
 370  * 3.0 Unported License http://creativecommons.org/licenses/by-nc-nd/3.0/
 371  ********************************************************************************
 372   
 373  SET cmat_bus Columns for tables "matched"      /bid_price, bid_power, matched_P/;
 374  SET in /in/;
 375  SET ou /out/;
 376   
 377  PARAMETER
 378  matched_generation_bus(b,t,g,bg,cmat_bus)
 379  matched_demand_bus(b,t,d,bd,cmat_bus)
 380  matched_inflow_bus(b,t,b_o,in,cmat_bus)
 381  matched_outflow_bus(b,t,b_o,ou,cmat_bus);
 382  *
 383  * Generation units
 384  *
 385  matched_generation_bus(b,t,g,bg,'bid_price')$gb(g,b) = lbg(t,g,bg);
 386  matched_generation_bus(b,t,g,bg,'bid_power')$gb(g,b) = pbg(t,g,bg);
 387  matched_generation_bus(b,t,g,bg,'matched_P')$gb(g,b) = PG.l(t,g,bg);
 388  * Positive inflow (= generation unit):
 389  matched_inflow_bus(b,t,b_o,in,'bid_price')$(l(b_o,b) and P.l(t,b_o,b)>0) = NODAL_MARKET.m(t,b_o);
 390  matched_inflow_bus(b,t,b_o,in,'bid_power')$(l(b_o,b) and P.l(t,b_o,b)>0) = P.up(t,b_o,b);
 391  matched_inflow_bus(b,t,b_o,in,'matched_P')$(l(b_o,b) and P.l(t,b_o,b)>0) = P.l(t,b_o,b);
 392  * Negative outflow (= positive inflow = generation unit):
 393  matched_inflow_bus(b,t,b_d,in,'bid_price')$(l(b,b_d) and P.l(t,b,b_d)<0) = NODAL_MARKET.m(t,b_d);
 394  matched_inflow_bus(b,t,b_d,in,'bid_power')$(l(b,b_d) and P.l(t,b,b_d)<0) = P.up(t,b,b_d);
 395  matched_inflow_bus(b,t,b_d,in,'matched_P')$(l(b,b_d) and P.l(t,b,b_d)<0) = -P.l(t,b,b_d);
 396  *
 397  * Demand units
 398  *
 399  matched_demand_bus(b,t,d,bd,'bid_price')$db(d,b)     = lbd(t,d,bd);
 400  matched_demand_bus(b,t,d,bd,'bid_power')$db(d,b)     = pbd(t,d,bd);
 401  matched_demand_bus(b,t,d,bd,'matched_P')$db(d,b)     = PD.l(t,d,bd);
 402  * Positive outflow (= demand unit):
 403  matched_outflow_bus(b,t,b_d,ou,'bid_price')$(l(b,b_d) and P.l(t,b,b_d)>0) = NODAL_MARKET.m(t,b_d);
 404  matched_outflow_bus(b,t,b_d,ou,'bid_power')$(l(b,b_d) and P.l(t,b,b_d)>0) = P.up(t,b,b_d);
 405  matched_outflow_bus(b,t,b_d,ou,'matched_P')$(l(b,b_d) and P.l(t,b,b_d)>0) = P.l(t,b,b_d);
 406  * Negative inflow ( = positive outflow = demand unit):
 407  matched_outflow_bus(b,t,b_o,ou,'bid_price')$(l(b_o,b) and P.l(t,b_o,b)<0) = NODAL_MARKET.m(t,b_o);
 408  matched_outflow_bus(b,t,b_o,ou,'bid_power')$(l(b_o,b) and P.l(t,b_o,b)<0) = P.up(t,b_o,b);
 409  matched_outflow_bus(b,t,b_o,ou,'matched_P')$(l(b_o,b) and P.l(t,b_o,b)<0) = -P.l(t,b_o,b);
 410   
 411  display
 412  matched_generation_bus, matched_inflow_bus,
 413  matched_demand_bus,     matched_outflow_bus;
INCLUDE    C:\Users\PC\Desktop\UPC\Energy Markets\GAMS files for MCM\TCMPA\TCMPA_disp_settlement.gms
 415  ********************************************************************************
 416  * F.-Javier Heredia f.javier.heredia(at)upc.edu http://gnom.upc.edu/heredia
 417  * Code under Creative Commons Attribution-NonCommercial-NoDerivs
 418  * 3.0 Unported License http://creativecommons.org/licenses/by-nc-nd/3.0/
 419  ********************************************************************************
 420   
 421  *
 422  * Settlement
 423  *
 424  SET rsg  Rows for generation settlement  / Revenue, 'Total rev.', Surplus, 'Total sur.'/;
 425  SET rsd  Rows for demand settlement      / Payment, 'Total pay.', Surplus, 'Total sur.'/;
 426  PARAMETER
 427  settlementG(rsg, g, t),
 428  settlementD(rsd, d, t),
 429  settlementGT(rsg, t),
 430  settlementDT(rsd, t);
 431  loop(t,
 432           loop(g,
 433                   settlementG('Revenue',g,t) =
 434                           sum(b$gb(g,b),NODAL_MARKET.m(t,b)*PGT.l(t,g));
 435                   settlementG('Surplus',g,t) =
 436                           settlementG('Revenue',g,t) - sum(bg,lbg(t,g,bg)*PG.l(t,g,bg))
 437           );
 438           settlementGT('Total rev.',t) = sum(g,settlementG('Revenue',g,t));
 439           settlementGT('Total sur.',t) = sum(g,settlementG('Surplus',g,t));
 440           loop(d,
 441                   settlementD('Payment',d,t) =
 442                           sum(b$db(d,b),NODAL_MARKET.m(t,b)*PDT.l(t,d));
 443                   settlementD('Surplus',d,t) =
 444                           sum(bd,lbd(t,d,bd)*PD.l(t,d,bd))- settlementD('Payment',d,t)
 445           );
 446           settlementDT('Total pay.',t) = sum(d,settlementD('Payment',d,t));
 447           settlementDT('Total sur.',t) = sum(d,settlementD('Surplus',d,t));
 448  );
 449   
 450  display settlementG, settlementD, settlementGT, settlementDT;
