INCLUDE    C:\Users\PC\Desktop\UPC\Energy Markets\GAMS files for MCM\TCMPA\TCMPA2M.gms
 498  ********************************************************************************
 499  * F.-Javier Heredia f.javier.heredia(at)upc.edu http://gnom.upc.edu/heredia
 500  * Code under Creative Commons Attribution-NonCommercial-NoDerivs
 501  * 3.0 Unported License http://creativecommons.org/licenses/by-nc-nd/3.0/
 502  ********************************************************************************
 503   
 504  file TCMPA_bus /TCMPA_bus.dat/;
 505  file TCMPA_eq  /TCMPA_eq.dat/;
 506  file TCMPA_lbg /TCMPA_lbg.dat/;
 507  file TCMPA_pbg /TCMPA_pbg.dat/;
 508  file TCMPA_PG  /TCMPA_PG.dat/;
 509  file TCMPA_lbd /TCMPA_lbd.dat/;
 510  file TCMPA_pbd /TCMPA_pbd.dat/;
 511  file TCMPA_PD  /TCMPA_PD.dat/;
 512   
 513  put TCMPA_bus; loop(bout, put bout.tl);
 514  put TCMPA_eq;
 515  scalar aux;
 516  loop(b$bout(b),
 517           loop(t,
 518                   put market_equilibrium(t,b,'energy');
 519                   put market_equilibrium(t,b,'price');
 520                   put market_equilibrium(t,b,'nodal SW');
 521                   put /
 522           );
 523  );
 524   
 525  loop(b$bout(b),
 526  put TCMPA_lbg;
 527  loop(t,
 528           loop(g$gb(g,b), loop(bg, put  lbg(t,g,bg)));
 529  *        Positive Inflow => generation unit
 530           loop(b_o$(l(b_o,b) and P.l(t,b_o,b)>0), put NODAL_MARKET.m(t,b_o));
 531  *        Negative Outflow => generation unit
 532           loop(b_d$(l(b,b_d) and P.l(t,b,b_d)<0), put NODAL_MARKET.m(t,b_d));
 533           put /);
 534  put TCMPA_pbg;
 535  loop(t,
 536           loop(g$gb(g,b), loop(bg, put  pbg(t,g,bg)));
 537  *        Positive Inflow => generation unit
 538           loop(b_o$(l(b_o,b) and P.l(t,b_o,b)>0), put  P.up(t,b_o,b));
 539  *        Negative Outflow => generation unit
 540           loop(b_d$(l(b,b_d) and P.l(t,b,b_d)<0), aux = -P.lo(t,b,b_d); put aux);
 541           put /);
 542  put TCMPA_PG;
 543  loop(t,
 544           loop(g$gb(g,b), loop(bg, put PG.l(t,g,bg)));
 545  *        Positive Inflow => generation unit
 546           loop(b_o$(l(b_o,b) and P.l(t,b_o,b)>0), put  P.l(t,b_o,b));
 547  *        Negative Outflow => generation unit
 548           loop(b_d$(l(b,b_d) and P.l(t,b,b_d)<0), aux = -P.l(t,b,b_d); put aux);
 549           put /);
 550  put TCMPA_lbd;
 551  loop(t,
 552           loop(d$db(d,b), loop(bd, put  lbd(t,d,bd)));
 553  *        Negative Inflow => demand unit
 554           loop(b_o$(l(b_o,b) and P.l(t,b_o,b)<0), put NODAL_MARKET.m(t,b_o));
 555  *        Positive Outflow => demand unit
 556           loop(b_d$(l(b,b_d) and P.l(t,b,b_d)>0), put NODAL_MARKET.m(t,b_d));
 557           put /);
 558  put TCMPA_pbd;
 559  loop(t,
 560           loop(d$db(d,b), loop(bd, put  pbd(t,d,bd)));
 561  *        Negative Inflow => demand unit
 562           loop(b_o$(l(b_o,b) and P.l(t,b_o,b)<0), aux = -P.lo(t,b_o,b); put aux);
 563  *        Positive Outflow => demand unit
 564           loop(b_d$(l(b,b_d) and P.l(t,b,b_d)>0), put  P.up(t,b,b_d));
 565           put /);
 566  put TCMPA_PD;
 567  loop(t,
 568           loop(d$db(d,b), loop(bd, put PD.l(t,d,bd)));
 569  *        Negative Inflow => demand unit
 570           loop(b_o$(l(b_o,b) and P.l(t,b_o,b)<0), aux = -P.l(t,b_o,b); put aux);
 571  *        Positive Outflow => demand unit
 572           loop(b_d$(l(b,b_d) and P.l(t,b,b_d)>0), put  P.l(t,b,b_d));
 573           put /);
 574  );
 575   
 576  *file TCMPA_PGT   /TCMPA_PGT.dat/;
 577  *file TCMPA_PGmin /TCMPA_PGmin.dat/;
 578  *file TCMPA_PGmax /TCMPA_PGmax.dat/;
 579  *file TCMPA_PGRU  /TCMPA_PGRU.dat/;
 580  *file TCMPA_PGRD  /TCMPA_PGRD.dat/;
 581   
 582  *put TCMPA_PGT;
 583  *loop(g,
 584  *loop(t0, put PGT.l(t0,g)); put/;
 585  *loop(t0, put pg_min(g)) ; put/;
 586  *loop(t0, put pg_max(g)) ; put/;
 587  *loop(t0, put rd(g))     ; put/;
 588  *loop(t0, put ru(g))     ; put/;
 589  *);
