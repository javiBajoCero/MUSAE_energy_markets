 462  * File for the Matlab function TCMPA_BF.m to represent the aggregated
 463  * bid functions and the matched energy for each time period.
 464  *
 465  file MPA_eq  /TCMPA_eq_T.dat/; put MPA_eq;
 466  scalar aux;
 467  loop(t,
 468  aux = sum(d, sum(bd, lbd(t,d,bd)*PD.l(t,d,bd))) - sum(g, sum(bg, lbg(t,g,bg)*PG.l(t,g,bg)));
 469  put sum(g, sum(bg, PG.l(t,g,bg)));
 470  put sum(b, market_equilibrium(t,b,'price'));
 471  put aux;
 472  put /);
 473   
 474  file MPA_lbg /TCMPA_lbg_T.dat/; put MPA_lbg; loop(t, loop(g, loop(bg, put lbg(t,g,bg)));  put /);
 475  file MPA_pbg /TCMPA_pbg_T.dat/; put MPA_pbg; loop(t, loop(g, loop(bg, put pbg(t,g,bg)));  put /);
 476  file MPA_PG  /TCMPA_PG_T.dat/;  put MPA_PG;  loop(t, loop(g, loop(bg, put PG.l(t,g,bg))); put /);
 477  file MPA_lbd /TCMPA_lbd_T.dat/; put MPA_lbd; loop(t, loop(d, loop(bd, put lbd(t,d,bd)));  put /);
 478  file MPA_pbd /TCMPA_pbd_T.dat/; put MPA_pbd; loop(t, loop(d, loop(bd, put pbd(t,d,bd)));  put /);
 479  file MPA_PD  /TCMPA_PD_T.dat/;  put MPA_PD;  loop(t, loop(d, loop(bd, put PD.l(t,d,bd))); put /);
 480   
 481  file MPA_PGT  /TCMPA_PGT.dat/;
 482  *file MPA_PGmin /TCMPA_PGmin.dat/;
 483  *file MPA_PGmax /TCMPA_PGmax.dat/;
 484  *file MPA_PGRU /TCMPA_PGRU.dat/;
 485  *file MPA_PGRD /TCMPA_PGRD.dat/;
 486   
 487  put MPA_PGT;
 488  loop(g,
 489  loop(t0, put PGT.l(t0,g)); put/;
 490  loop(t0, put pg_min(g)) ; put/;
 491  loop(t0, put pg_max(g)) ; put/;
 492  loop(t0, put rd(g))     ; put/;
 493  loop(t0, put ru(g))     ; put/;
 494  );
