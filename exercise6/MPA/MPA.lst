   8   
   9  *********************************************************************
  10  * DATA
  11  *********************************************************************
  12   
  13  * Time periods;
  14   
  15  SETS t0    Extended time periods / t0*t2 /
  16  SETS t(t0) Time periods / t1*t2 /
  17   
  18  * Generation units:
  19   
  20  SETS
  21  g Generation units / G1*G2/
  22  bg Blocks           /b1*b2/;
  23   
  24  PARAMETERS
  25  pg_max(g) Max. active power generation [MW] /G1 20, G2 30/
  26  pg_min(g) Min. active power generation [MW] /G1  5, G2 10/
  27  ru(g)     Ramp-up limit [MW:h]              /G1  5, G2 10/
  28  rd(g)     Ramp-down limit [MW]              /G1  5, G2 10/
  29  p0(g)     Initial power output [MW]         /G1 10, G2 15/;
  30   
  31  TABLE pbg(t,g,bg) Power [MW] of the generation bid function
  32         b1  b2
  33  t1.G1   5  15
  34  t1.G2   10 20
  35  t2.G1   5  15
  36  t2.G2   10 20;
  37   
  38  TABLE lbg(t,g,bg) Prices [eur:MWh] of the generation bid function
  39        b1   b2
  40  t1.G1  10 13
  41  t1.G2  15 18
  42  t2.G1  10 13
  43  t2.G2  15 18;
  44   
  45  * Demand units:
  46   
  47  SETS
  48  d Generation units / D1 /
  49  bd Blocks          / b1*b2 /;
  50   
  51  TABLE pbd(t,d,bd) Power [MW] of the demand bid function
  52        b1 b2
  53  t1.D1  12 15
  54  t2.D1  25 30;
  55   
  56  TABLE lbd(t,d,bd) Prices [�:MWh] of the generation bid function
  57        b1 b2
  58  t1.D1 20 10
  59  t2.D1 20 10 ;
  60   
  61  *********************************************************************
  62  * VARIABLES
  63  *********************************************************************
  64   
  65  FREE VARIABLE     SW         Social welfare (objective function)
  66  POSITIVE VARIABLE PG(t,g,bg) Matched generation of each block [MW]
  67                    PD(t,d,bd) Matched demand of each block [MW]
  68                    PGT(t0,g)  Total matched generation [MW]
  69                    PDT(t,d)   Total matched demand [MW];
  70  BINARY VARIABLE   U(t,g)       on-off state of the unit;
  71   
  72  * Total generation at t=0:
  73  PGT.fx('t0',g) = p0(g);
  74   
  75  *********************************************************************
  76  * OBJECTIVE FUNCTION AND CONSTRAINTS
  77  *********************************************************************
  78   
  79  EQUATIONS
  80  OF            Objective function
  81  MATCHED_G     Matched generation to generation block coupling
  82  MATCHED_D     Matched demand to demand block coupling
  83  TOT_MATCHED_G Total matched generation
  84  TOT_MATCHED_D Total matched demand
  85  MARKET      Market equilibrium
  86  RAMP_D      Ramp down limit constraints
  87  RAMP_U      Ramp up limit constraints
  88  PGMIN       Minimum generation
  89  PGMAX       Maximum generation;
  90   
  91  * Social Welfare:
  92  OF.. SW =e=
  93  sum(t,
  94        sum(d, sum(bd, lbd(t,d,bd)*PD(t,d,bd)))
  95      - sum(g, sum(bg, lbg(t,g,bg)*PG(t,g,bg)))
  96     );
  97   
  98  * Matched generation to generation block coupling:
  99  MATCHED_G(t,g,bg).. PG(t,g,bg) =l= pbg(t,g,bg);
 100   
 101  * Matched demand to demand block coupling:
 102  MATCHED_D(t,d,bd).. PD(t,d,bd) =l= pbd(t,d,bd);
 103   
 104  * Total matched generation:
 105  TOT_MATCHED_G(t,g).. PGT(t,g) =e= sum(bg, PG(t,g,bg));
 106   
 107  * Total matched demand:
 108  TOT_MATCHED_D(t,d).. PDT(t,d) =e= sum(bd, PD(t,d,bd));
 109   
 110  * Market Equilibrium:
 111  MARKET(t)..  sum(g, PGT(t,g)) - sum(d, PDT(t,d)) =e= 0;
 112   
 113  * Ramp down limit:
 114  RAMP_D(t0,g)$(ord(t0) gt 1).. PGT(t0,g) - PGT(t0-1,g) =g= -rd(g);
 115   
 116  * Ramp up limit:
 117  RAMP_U(t0,g)$(ord(t0) gt 1).. PGT(t0,g) - PGT(t0-1,g) =l= ru(g);
 118   
 119  * Generation limits:
 120  PGMIN(t,g)..  PGT(t,g) =g= pg_min(g)*U(t,g);
 121  PGMAX(t,g)..  PGT(t,g) =l= pg_max(g)*U(t,g);
 122   
 123  *********************************************************************
 124  * OPTIMIZATION
 125  *********************************************************************
 126   
 127  SET cmat Columns for tables "matched"    /bid_price, bid_power, matched_P/;
 128  SET ceq  Rows for market clearing tables / SocWel , price, energy/;
 129   
 130  PARAMETER
 131  matched_generation(t,g,bg,cmat), matched_demand(t,d,bd,cmat),
 132  market_equilibrium(t,ceq);
 133   
 134  matched_generation(t,g,bg,'bid_price') = lbg(t,g,bg);
 135  matched_generation(t,g,bg,'bid_power') = pbg(t,g,bg);
 136  matched_demand(t,d,bd,'bid_price')     = lbd(t,d,bd);
 137  matched_demand(t,d,bd,'bid_power')     = pbd(t,d,bd);
 138   
 139  MODEL MPA    / ALL /;
 140  SOLVE MPA USING mip MAXIMIZING SW;
 141   
 142  * Linear relaxation of the full model to catch up the market clearing price:
 143  * We first fix the optimal value of the binary variables;
 144  U.fx(t,g) = U.l(t,g);
 145  * And then solve the linear relaxation pf SPA;
 146  SOLVE MPA USING rmip MAXIMIZING SW;
 147   
 148  *********************************************************************
 149  * MARKET CLEARING LOG
 150  *********************************************************************
INCLUDE    C:\Users\citcea\Documents\GitHub\MUSAE\MUSAE_energy_markets\exercise6\MPA\MPA_disp.gms
 152  ********************************************************************************
 153  * F.-Javier Heredia f.javier.heredia(at)upc.edu http://gnom.upc.edu/heredia
 154  * Code under Creative Commons Attribution-NonCommercial-NoDerivs
 155  * 3.0 Unported License http://creativecommons.org/licenses/by-nc-nd/3.0/
 156  ********************************************************************************
 157  *
 158  * Equilibrium
 159  *
 160  matched_generation(t,g,bg,'matched_P') = PG.l(t,g,bg);
 161  matched_demand(t,d,bd,'matched_P')     = PD.l(t,d,bd);
 162   
 163  loop(t,
 164  market_equilibrium(t,'SocWel') =
 165     sum(d, sum(bd, lbd(t, d, bd)*PD.l(t,d,bd)))
 166   - sum(g, sum(bg, lbg(t, g, bg)*PG.l(t,g,bg)));
 167  market_equilibrium(t,'energy') = sum(d, PDT.l(t,d));
 168  market_equilibrium(t,'price')  = -MARKET.m(t);
 169  );
 170   
 171  * Tables to compare market clearing:
 172  display
 173  matched_generation, PGT.l,
 174  matched_demand    , PDT.l,
 175  market_equilibrium;
 176  *
 177  * Settlement
 178  *
 179  SET rsg  Rows for generation settlement  / Revenue, 'Total rev.', Surplus, 'Total sur.'/;
 180  SET rsd  Rows for demand settlement      / Payment, 'Total pay.', Surplus, 'Total sur.'/;
 181  PARAMETER
 182  settlementG(rsg, g, t),
 183  settlementD(rsd, d, t),
 184  settlementGT(rsg, t),
 185  settlementDT(rsd, t);
 186  loop(t,
 187           loop(g,
 188                   settlementG('Revenue',g,t) = -MARKET.m(t)*PGT.l(t,g);
 189                   settlementG('Surplus',g,t) =
 190                           settlementG('Revenue',g,t) - sum(bg,lbg(t,g,bg)*PG.l(t,g,bg))
 191           );
 192           settlementGT('Total rev.',t) = sum(g,settlementG('Revenue',g,t));
 193           settlementGT('Total sur.',t) = sum(g,settlementG('Surplus',g,t));
 194           loop(d,
 195                   settlementD('Payment',d,t) = -MARKET.m(t)*PDT.l(t,d);
 196                   settlementD('Surplus',d,t) =
 197                           sum(bd,lbd(t,d,bd)*PD.l(t,d,bd))- settlementD('Payment',d,t)
 198           );
 199           settlementDT('Total pay.',t) = sum(d,settlementD('Payment',d,t));
 200           settlementDT('Total sur.',t) = sum(d,settlementD('Surplus',d,t));
 201  );
 202   
 203  display settlementG, settlementD, settlementGT, settlementDT;
 204  *********************************************************************
 205  * Matlab FILES FOR MARKET CLEARING PLOTS
 206  *********************************************************************
INCLUDE    C:\Users\citcea\Documents\GitHub\MUSAE\MUSAE_energy_markets\exercise6\MPA\MPA2M.gms
 208  * F.-Javier Heredia f.javier.heredia(at)upc.edu http://gnom.upc.edu/heredia
 209  * Code under Creative Commons Attribution-NonCommercial-NoDerivs
 210  * 3.0 Unported License http://creativecommons.org/licenses/by-nc-nd/3.0/
 211  *
 212  * GAMS code that creates the ASCII files MPA_lbg.dat, MPA_pbg.dat and MPA_PG.dat
 213  * to plot the bid function with Matlab's file MPA_BF.m. Just add the sentence:
 214  *
 215  * $include MPA2M
 216  *
 217  * at the end opf the MPA.gms file.
 218  *
 219   
 220  file MPA_eq  /MPA_eq.dat/; put MPA_eq;
 221  loop(t,
 222  put market_equilibrium(t,'energy');
 223  put market_equilibrium(t,'price');
 224  put market_equilibrium(t,'SocWel');
 225  put /);
 226  file MPA_lbg /MPA_lbg.dat/; put MPA_lbg; loop(t, loop(g, loop(bg, put lbg(t,g,bg)));  put /);
 227  file MPA_pbg /MPA_pbg.dat/; put MPA_pbg; loop(t, loop(g, loop(bg, put pbg(t,g,bg)));  put /);
 228  file MPA_PG  /MPA_PG.dat/;  put MPA_PG;  loop(t, loop(g, loop(bg, put PG.l(t,g,bg))); put /);
 229  file MPA_lbd /MPA_lbd.dat/; put MPA_lbd; loop(t, loop(d, loop(bd, put lbd(t,d,bd)));  put /);
 230  file MPA_pbd /MPA_pbd.dat/; put MPA_pbd; loop(t, loop(d, loop(bd, put pbd(t,d,bd)));  put /);
 231  file MPA_PD  /MPA_PD.dat/;  put MPA_PD;  loop(t, loop(d, loop(bd, put PD.l(t,d,bd))); put /);
 232   
 233  file MPA_PGT  /MPA_PGT.dat/;
 234  file MPA_PGmin /MPA_PGmin.dat/;
 235  file MPA_PGmax /MPA_PGmax.dat/;
 236  file MPA_PGRU /MPA_PGRU.dat/;
 237  file MPA_PGRD /MPA_PGRD.dat/;
 238   
 239  put MPA_PGT;
 240  loop(g,
 241  loop(t0, put PGT.l(t0,g)); put/;
 242  loop(t0, put pg_min(g)) ; put/;
 243  loop(t0, put pg_max(g)) ; put/;
 244  loop(t0, put rd(g))     ; put/;
 245  loop(t0, put ru(g))     ; put/;
 246  );
