C o m p i l a t i o n


   8   
   9  *********************************************************************
  10  * DATA
  11  *********************************************************************
  12   
  13  * Generation units:
  14   
  15  SETS
  16  g Generation units / G1/
  17  bg Blocks           /1*2/;
  18   
  19  PARAMETERS
  20  pg_max(g) Max. active power generation [MW] /G1 30/
  21  pg_min(g) Min. active power generation [MW] /G1  15/
  22  ru(g)     Ramp-up limit [MW:h]              /G1  5/
  23  rd(g)     Ramp-down limit [MW]              /G1  5/
  24  p0(g)     Initial power output [MW]         /G1 30/;
  25   
  26  TABLE pbg(g,bg) Power [MW] of the generation bid function
  27       1  2
  28  G1   5  5 ;
  29   
  30  TABLE lbg(g,bg) Prices [eur:MWh] of the generation bid function
  31       1  2
  32  G1   1  3 ;
  33   
  34  * Demand units:
  35   
  36  SETS
  37  d Generation units / D1/
  38  bd Blocks          / 1*2 /;
  39   
  40  TABLE pbd(d,bd) Power [MW] of the demand bid function
  41      1 2
  42  D1  3 6;
  43   
  44  TABLE lbd(d,bd) Prices [�:MWh] of the generation bid function
  45      1  2
  46  D1  5  2;
  47   
  48  display pbg, lbg, pbd, lbd;
  49   
  50  *********************************************************************
  51  * VARIABLES
  52  *********************************************************************
  53   
  54  FREE VARIABLE     SW       Social welfare (objective function)
  55  POSITIVE VARIABLE PG(g,bg) Matched generation of each block [MW]
  56                    PD(d,bd) Matched demand of each block [MW];
  57  BINARY VARIABLE   U(g)    on-off state of the unit;
  58   
  59  *********************************************************************
  60  * OBJECTIVE FUNCTION AND CONSTRAINTS
  61  *********************************************************************
  62   
  63  EQUATIONS
  64  OF         Objective function
  65  MATCHED_G  Matched generation to generation block coupling
  66  MATCHED_D  Matched demand to demand block coupling
  67  MARKET     Market equilibrium
  68  RAMP_D     Ramp down limit constraints
  69  RAMP_U     Ramp up limit constraints
  70  PGMIN      Minimum generation
  71  PGMAX      Maximum generation;
  72   
  73  * Social Welfare:
  74  OF.. SW =e=  sum(d, sum(bd, lbd(d,bd)*PD(d,bd)))
  75             - sum(g, sum(bg,lbg(g,bg)*PG(g,bg)));
  76   
  77  * Matched generation to generation block coupling:
  78  MATCHED_G(g,bg).. PG(g,bg) =l= pbg(g,bg);
  79   
  80  * Matched demand to demand block coupling:
  81  MATCHED_D(d,bd).. PD(d,bd) =l= pbd(d,bd);
  82   
  83  * Market Equilibrium:
  84  MARKET.. sum(d, sum(bd, PD(d,bd) )) =e=
  85           sum(g, sum(bg, PG(g,bg) ));
  86   
  87  * Ramp down limit:
  88  *RAMP_D(g).. sum(bg, PG(g,bg)) - p0(g) =g= - rd(g);
  89   
  90  * Ramp up limit:
  91  *RAMP_U(g).. sum(bg, PG(g,bg)) - p0(g) =l=   ru(g);
  92   
  93  * Generation limits:
  94  *PGMIN(g)..  sum(bg, PG(g,bg)) =g= pg_min(g)*U(g);
  95  *PGMAX(g)..  sum(bg, PG(g,bg)) =l= pg_max(g)*U(g);
  96   
  97  *********************************************************************
  98  * OPTIMIZATION
  99  *********************************************************************
 100   
 101  SET sc Columns for tables "_s" /bid_price, bid_power, SPA0 , SPA/;
 102  SET req Rows for market clearing tables / SocWel , price, energy/;
 103  SET mod Columns for market clearing tables / SPA0 , SPA/;
 104  PARAMETER
 105  matched_generation(g,bg,sc), total_matched_generation(g,sc),
 106  matched_demand(d,bd,sc), total_matched_demand(d,sc),
 107  market_equilibrium(req,mod);
 108  * Lagrange multipliers mu;
 109  SET mucolG / 'la^*=', 'la^b', '-mu^0', '-mu^b' /;
 110  SET mucolD / 'la^*=', 'la^b', '+mu^0', '+mu^b' /;
 111  PARAMETERS muG_0(g,bg,mucolG),muD_0(d,bd,mucolD);
 112   
 113  matched_generation(g,bg,'bid_price') = lbg(g,bg);
 114  matched_generation(g,bg,'bid_power') = pbg(g,bg);
 115  matched_demand(d,bd,'bid_price')     = lbd(d,bd);
 116  matched_demand(d,bd,'bid_power')     = pbd(d,bd);
 117   
 118  muG_0(g,bg,'la^b') = lbg(g,bg);
 119  muD_0(d,bd,'la^b') = lbd(d,bd);
 120   
 121  * Simplified model (LP):
 122   
 123  MODEL SPA0  / OF, MATCHED_G, MATCHED_D, MARKET/;
 124  SOLVE SPA0 USING lp MAXIMIZING SW;
 125   
 126  matched_generation(g,bg,'SPA0')     = PG.l(g,bg);
 127  total_matched_generation(g,'SPA0')  = sum(bg,PG.l(g,bg));
 128  matched_demand(d,bd,'SPA0')         = PD.l(d,bd);
 129  total_matched_demand(d,'SPA0')      = sum(bd,PD.l(d,bd));
 130  market_equilibrium('SocWel','SPA0') = SW.l;
 131  market_equilibrium('price', 'SPA0') = MARKET.m;
 132  market_equilibrium('energy', 'SPA0')= sum(d, sum( bd,PD.l(d,bd)));
 133   
 134  muG_0(g,bg,'la^*=')    = MARKET.m;
 135  muD_0(d,bd,'la^*=')    = MARKET.m;
 136  * The signs of the lag. mult. in GAMS are the opposite of those defined in classroom;
 137  muG_0(g,bg,'-mu^0') = PG.m(g,bg);
 138  muG_0(g,bg,'-mu^b') = MATCHED_G.m(g,bg);
 139  muD_0(d,bd,'+mu^0') = -PD.m(d,bd);
 140  muD_0(d,bd,'+mu^b') = -MATCHED_D.m(d,bd);
 141   
 142  * Full model (MIP):
 143   
 144  *MODEL SPA    / ALL /;
 145  *SOLVE SPA USING mip MAXIMIZING SW;
 146   
 147  *matched_generation(g,bg,'SPA')   = PG.l(g,bg);
 148  *total_matched_generation(g,'SPA')= sum(bg,PG.l(g,bg));
 149  *matched_demand(d,bd,'SPA')       = PD.l(d,bd);
 150  *total_matched_demand(d,'SPA')    = sum(bd,PD.l(d,bd));
 151  *market_equilibrium('SocWel','SPA') = SW.l;
 152  *market_equilibrium('energy', 'SPA')= sum(d, sum( bd,PD.l(d,bd)));
 153   
 154  * Continuous problem associated to SPA (CSPA):
 155   
 156  * We first set the optimal value of the binary variables;
 157  *U.fx(g) = U.l(g);
 158  * And then solve the linear relaxation of SPA;
 159  *SOLVE SPA USING rmip MAXIMIZING SW;
 160  *market_equilibrium('price', 'SPA') = MARKET.m;
 161   
 162  * Output:
 163   
 164  display
 165  matched_generation, total_matched_generation,
 166  matched_demand    , total_matched_demand,
 167  market_equilibrium,
 168  muG_0, muD_0;
