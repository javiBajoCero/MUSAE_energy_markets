 184  file SPA_pbg /SPA_pbg.dat/; put SPA_pbg; loop(g, loop(bg, put pbg(g,bg)));  put /;
 185  file SPA_PG  /SPA_PG.dat/;  put SPA_PG;  loop(g, loop(bg, put PG.l(g,bg))); put /;
 186  file SPA_lbd /SPA_lbd.dat/; put SPA_lbd; loop(d, loop(bd, put lbd(d,bd)));  put /;
 187  file SPA_pbd /SPA_pbd.dat/; put SPA_pbd; loop(d, loop(bd, put pbd(d,bd)));  put /;
 188  file SPA_PD  /SPA_PD.dat/;  put SPA_PD;  loop(d, loop(bd, put PD.l(d,bd))); put /;
