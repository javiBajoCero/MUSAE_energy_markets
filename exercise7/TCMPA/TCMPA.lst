   8   
   9  *********************************************************************
  10  * DATA
  11  *********************************************************************
  12   
  13  * Time periods;
  14   
  15  SETS t0    Extended time periods / t0*t1 /
  16  SETS t(t0) Time periods / t1 /
  17   
  18  * Units:
  19   
  20  * Generation units:
  21   
  22  SETS
  23  g  Generation units / G1/
  24  bg Blocks           /b1*b2/;
  25   
  26  PARAMETERS
  27  pg_max(g) Max. active power generation [MW] /G1 10/
  28  pg_min(g) Min. active power generation [MW] /G1  0/
  29  ru(g)     Ramp-up limit [MW:h]              /G1  10/
  30  rd(g)     Ramp-down limit [MW]              /G1  10/
  31  p0(g)     Initial power output [MW]         /G1 0/;
  32   
  33  TABLE pbg(t,g,bg) Power [MW] of the generation bid function
INCLUDE    C:\Users\citcea\Documents\GitHub\MUSAE\MUSAE_energy_markets\exercise7\TCMPA\t2_pbg.gms
  35         b1  b2
  36  t1.G1   5  5 ;
  37   
  38  TABLE lbg(t,g,bg) Prices [eur:MWh] of the generation bid function
INCLUDE    C:\Users\citcea\Documents\GitHub\MUSAE\MUSAE_energy_markets\exercise7\TCMPA\t2_lbg.gms
  40        b1   b2
  41  t1.G1  1   3;
  42   
  43  * Demand units:
  44   
  45  SETS
  46  d  Demand units / D1 /
  47  bd Blocks       / b1*b2 /;
  48   
  49  TABLE pbd(t,d,bd) Power [MW] of the demand bid function
INCLUDE    C:\Users\citcea\Documents\GitHub\MUSAE\MUSAE_energy_markets\exercise7\TCMPA\t2_pbd.gms
  51        b1  b2
  52  t1.D1  3  6;
  53   
  54  TABLE lbd(t,d,bd) Prices [�:MWh] of the generation bid function
INCLUDE    C:\Users\citcea\Documents\GitHub\MUSAE\MUSAE_energy_markets\exercise7\TCMPA\t2_lbd.gms
  56        b1 b2
  57  t1.D1 5  2;
  58   
  59  * Buses:
  60   
  61  SET  b      Buses            / bus1*bus2 /;
  62  SET refb(b) Reference bus    / bus1 /;
  63  alias(b,b_o,b_d);
  64   
  65  SET gb(g,b) Generation buses / G1.bus1 /;
  66  SET db(d,b) Demand buses     / D1.bus2 /;
  67   
  68  * Lines;
  69   
  70  SET l(b_o,b_d) lines / bus1.bus2 /;
  71   
  72  display gb, db, refb, l;
  73   
  74  PARAMETERS pbase basepower [MVAr] / 100 /;
  75  TABLE x(b,b) Line reactance [p.u.]
  76        bus1 bus2
  77  bus1   0.0  0.1
  78  bus2   0.0  0.0  ;
  79   
  80  TABLE s_max(b,b) Line capacity [MVA]
  81        bus1  bus2
  82  bus1     0    2
  83  bus2     0    0    ;
  84   
  85  *********************************************************************
  86  * VARIABLES
  87  *********************************************************************
  88   
  89  FREE VARIABLE     SW         Social welfare (objective function);
  90  * Generation;
  91  POSITIVE VARIABLE PG(t,g,bg) Matched generation of each block [MW]
  92                    PGT(t0,g)  Total matched generation [MW]
  93  BINARY VARIABLE   U(t,g)     on-off state of the unit;
  94  * Total generation at t=0:
  95  PGT.fx('t0',g) = p0(g);
  96   
  97  * Demand;
  98  POSITIVE VARIABLE PD(t,d,bd) Matched demand of each block [MW]
  99                    PDT(t,d)   Total matched demand [MW];
 100  * Grid;
 101  VARIABLE P(t,b,b)   Line power [MW]
 102           Th(t,b)    Voltage phase;
 103   
 104  P.fx(t,b_o,b_d)$(not l(b_o,b_d)) = 0.0;
 105  P.lo(t,b_o,b_d)   = -s_max(b_o,b_d);
 106  P.up(t,b_o,b_d)   = s_max(b_o,b_d);
 107   
 108  Th.fx(t,refb) = 0.0;
 109   
 110  *********************************************************************
 111  * OBJECTIVE FUNCTION AND CONSTRAINTS
 112  *********************************************************************
 113   
 114  EQUATIONS
 115  OF            Objective function
 116  MATCHED_G     Matched generation to generation block coupling
 117  MATCHED_D     Matched demand to demand block coupling
 118  TOT_MATCHED_G Total matched generation
 119  TOT_MATCHED_D Total matched demand
 120  NODAL_MARKET  Market equilibrium at bus
 121  LPFE          Line power flow equations
 122  RAMP_D        Ramp down limit constraints
 123  RAMP_U        Ramp up limit constraints
 124  PGMIN         Minimum generation
 125  PGMAX         Maximum generation;
 126   
 127  * Social Welfare:
 128  OF.. SW =e=
 129  sum(t,
 130        sum(d, sum(bd, lbd(t,d,bd)*PD(t,d,bd)))
 131      - sum(g, sum(bg, lbg(t,g,bg)*PG(t,g,bg)))
 132     );
 133   
 134  * Matched generation to generation block coupling:
 135  MATCHED_G(t,g,bg).. PG(t,g,bg) =l= pbg(t,g,bg);
 136   
 137  * Matched demand to demand block coupling:
 138  MATCHED_D(t,d,bd).. PD(t,d,bd) =l= pbd(t,d,bd);
 139   
 140  * Total matched generation:
 141  TOT_MATCHED_G(t,g).. PGT(t,g) =e= sum(bg, PG(t,g,bg));
 142   
 143  * Total matched demand:
 144  TOT_MATCHED_D(t,d).. PDT(t,d) =e= sum(bd, PD(t,d,bd));
 145   
 146  * Market Equilibrium:
 147  NODAL_MARKET(t,b)..
 148  * Total power outflow to the grid:
 149    sum(b_d$l(b,b_d), P(t,b,b_d))
 150  * Total power inflow  from the grid:
 151  - sum(b_o$l(b_o,b), P(t,b_o,b))
 152  * Net power balance of bus "b":
 153  =e= sum(g$gb(g,b),PGT(t,g))- sum(d$db(d,b),PDT(t,d)) ;
 154   
 155  * Line power flow equations:
 156  LPFE(t,b_o,b_d)$l(b_o,b_d).. P(t,b_o,b_d) =e= pbase*(Th(t,b_o)-Th(t,b_d))/x(b_o,b_d);
 157   
 158  * Ramp down limit:
 159  RAMP_D(t0,g)$(ord(t0) gt 1).. PGT(t0,g) - PGT(t0-1,g) =g= -rd(g);
 160   
 161  * Ramp up limit:
 162  RAMP_U(t0,g)$(ord(t0) gt 1).. PGT(t0,g) - PGT(t0-1,g) =l= ru(g);
 163   
 164  * Generation limits:
 165  PGMIN(t,g)..  PGT(t,g) =g= pg_min(g)*U(t,g);
 166  PGMAX(t,g)..  PGT(t,g) =l= pg_max(g)*U(t,g);
 167   
 168  *********************************************************************
 169  * OPTIMIZATION
 170  *********************************************************************
 171   
 172  MODEL TCMPA    / ALL /;
 173  option optCR = 0.0;
 174  SOLVE TCMPA USING mip MAXIMIZING SW;
 175  U.fx(t,g) = U.l(t,g);
 176  SOLVE TCMPA USING rmip MAXIMIZING SW;
 177   
 178  *********************************************************************
 179  * MARKET CLEARING LOG
 180  *********************************************************************
 181   
 182  display NODAL_MARKET.m;
INCLUDE    C:\Users\citcea\Documents\GitHub\MUSAE\MUSAE_energy_markets\exercise7\TCMPA\TCMPA_disp_equilibrium.gms
 184  ********************************************************************************
 185  * F.-Javier Heredia f.javier.heredia(at)upc.edu http://gnom.upc.edu/heredia
 186  * Code under Creative Commons Attribution-NonCommercial-NoDerivs
 187  * 3.0 Unported License http://creativecommons.org/licenses/by-nc-nd/3.0/
 188  ********************************************************************************
 189   
 190  SET cmat         Columns for tables "matched"      /bid_price, bid_power, matched_P/;
 191  SET ceq          Columns for "equilibrium" table   / 'price', 'energy', 'gen.', 'dem.', 'inflow', 'outflow',  'surp. gen.','surp. dem.', SW, 'surp. inf.', 'surp. out.', 'nodal SW'/;
 192  SET ceqt(ceq)    Columns for "equilibrium_T" table / 'energy', 'gen.', 'dem.', 'inflow', 'outflow',  'surp. gen.','surp. dem.', SW/;
 193  SET cmer         Columns for "merchandizing" table / 'price sell','price buy', 'energy', 'mer. surp.'/;
 194   
 195  PARAMETER
 196  matched_generation(t,g,bg,cmat), matched_demand(t,d,bd,cmat),
 197  market_equilibrium(t,b,ceq),
 198  market_equilibrium_T(t,ceqt),
 199  market_merchandizing(t,b,b,cmer);
 200   
 201  matched_generation(t,g,bg,'bid_price') = lbg(t,g,bg);
 202  matched_generation(t,g,bg,'bid_power') = pbg(t,g,bg);
 203  matched_demand(t,d,bd,'bid_price')     = lbd(t,d,bd);
 204  matched_demand(t,d,bd,'bid_power')     = pbd(t,d,bd);
 205   
 206  matched_generation(t,g,bg,'matched_P') = PG.l(t,g,bg);
 207  matched_demand(t,d,bd,'matched_P')     = PD.l(t,d,bd);
 208   
 209  *
 210  * Market equilibrium
 211  *
 212  loop(t,
 213   loop(b,
 214  *
 215  * Social Welfare
 216  *
 217    market_equilibrium(t,b,'surp. dem.') =
 218  * Demand and generation surplus:
 219    sum(d$db(d,b), sum(bd, (lbd(t, d, bd)-NODAL_MARKET.M(t,b))*PD.l(t,d,bd)));
 220    market_equilibrium(t,b,'surp. gen.') =
 221  * Demand and generation surplus:
 222   + sum(g$gb(g,b), sum(bg, (NODAL_MARKET.M(t,b)-lbg(t, g, bg))*PG.l(t,g,bg)));
 223    market_equilibrium(t,b,'SW') =
 224           market_equilibrium(t,b,'surp. dem.')
 225         + market_equilibrium(t,b,'surp. gen.');
 226  *
 227  * Nodal Equilibrium
 228  *
 229    market_equilibrium(t,b,'gen.')    = sum(g$gb(g,b), PGT.l(t,g));
 230    market_equilibrium(t,b,'dem.')    = sum(d$db(d,b), PDT.l(t,d));
 231    market_equilibrium(t,b,'inflow')  =
 232            sum(b_o$(l(b_o,b) and P.l(t,b_o,b)>0),P.l(t,b_o,b))
 233          - sum(b_d$(l(b,b_d) and P.l(t,b,b_d)<0),P.l(t,b,b_d));
 234    market_equilibrium(t,b,'surp. inf.')  =
 235            sum(b_o$(l(b_o,b) and P.l(t,b_o,b)>0), (NODAL_MARKET.M(t,b)-NODAL_MARKET.M(t,b_o))*P.l(t,b_o,b))
 236          - sum(b_d$(l(b,b_d) and P.l(t,b,b_d)<0), (NODAL_MARKET.M(t,b)-NODAL_MARKET.M(t,b_d))*P.l(t,b,b_d));
 237    market_equilibrium(t,b,'outflow') =
 238            sum(b_d$(l(b,b_d) and P.l(t,b,b_d)>0),P.l(t,b,b_d))
 239          - sum(b_o$(l(b_o,b) and P.l(t,b_o,b)<0),P.l(t,b_o,b));
 240    market_equilibrium(t,b,'surp. out.') =
 241            sum(b_d$(l(b,b_d) and P.l(t,b,b_d)>0), (NODAL_MARKET.M(t,b_d)-NODAL_MARKET.M(t,b))*P.l(t,b,b_d))
 242          - sum(b_o$(l(b_o,b) and P.l(t,b_o,b)<0), (NODAL_MARKET.M(t,b_o)-NODAL_MARKET.M(t,b))*P.l(t,b_o,b));
 243    market_equilibrium(t,b,'nodal SW') =   market_equilibrium(t,b,'SW')
 244                                         + market_equilibrium(t,b,'surp. inf.')
 245                                         + market_equilibrium(t,b,'surp. out.');
 246   
 247    market_equilibrium(t,b,'energy') =
 248           market_equilibrium(t,b,'gen.')
 249        +  market_equilibrium(t,b,'inflow');
 250    market_equilibrium(t,b,'price')  = NODAL_MARKET.m(t,b);
 251   );
 252  loop(ceqt, market_equilibrium_T(t,ceqt) = sum(b, market_equilibrium(t,b,ceqt)));
 253  );
 254  *
 255  * Merchandising surplus:
 256  *
 257  loop(t,
 258     loop(b_o,
 259        loop(b_d$(l(b_o,b_d) and P.l(t,b_o,b_d)>0),
 260  *     Positive outflow:
 261        market_merchandizing(t,b_o,b_d,'price buy') = NODAL_MARKET.m(t,b_o);
 262        market_merchandizing(t,b_o,b_d,'price sell')  = NODAL_MARKET.m(t,b_d);
 263        market_merchandizing(t,b_o,b_d,'energy')       = P.l(t,b_o,b_d);
 264        market_merchandizing(t,b_o,b_d,'mer. surp.') = (NODAL_MARKET.m(t,b_d)-NODAL_MARKET.m(t,b_o))*P.l(t,b_o,b_d);
 265        );
 266        loop(b_d$(l(b_o,b_d) and P.l(t,b_o,b_d)<0),
 267  *     Negative outflow (inflow):
 268        market_merchandizing(t,b_o,b_d,'price buy')  = NODAL_MARKET.m(t,b_d);
 269        market_merchandizing(t,b_o,b_d,'price sell') = NODAL_MARKET.m(t,b_o);
 270        market_merchandizing(t,b_o,b_d,'energy')     = -P.l(t,b_o,b_d);
 271        market_merchandizing(t,b_o,b_d,'mer. surp.') = (NODAL_MARKET.m(t,b_d)-NODAL_MARKET.m(t,b_o))*P.l(t,b_o,b_d);
 272        );
 273     );
 274  );
 275  display
 276  matched_generation, PGT.l,
 277  matched_demand    , PDT.l,
 278  market_equilibrium,
 279  market_equilibrium_T,
 280  market_merchandizing;
INCLUDE    C:\Users\citcea\Documents\GitHub\MUSAE\MUSAE_energy_markets\exercise7\TCMPA\TCMPA_disp_equilibrium_bus.gms
 282  ********************************************************************************
 283  * F.-Javier Heredia f.javier.heredia(at)upc.edu http://gnom.upc.edu/heredia
 284  * Code under Creative Commons Attribution-NonCommercial-NoDerivs
 285  * 3.0 Unported License http://creativecommons.org/licenses/by-nc-nd/3.0/
 286  ********************************************************************************
 287   
 288  SET cmat_bus Columns for tables "matched"      /bid_price, bid_power, matched_P/;
 289  SET in /in/;
 290  SET ou /out/;
 291   
 292  PARAMETER
 293  matched_generation_bus(b,t,g,bg,cmat_bus)
 294  matched_demand_bus(b,t,d,bd,cmat_bus)
 295  matched_inflow_bus(b,t,b_o,in,cmat_bus)
 296  matched_outflow_bus(b,t,b_o,ou,cmat_bus);
 297  *
 298  * Generation units
 299  *
 300  matched_generation_bus(b,t,g,bg,'bid_price')$gb(g,b) = lbg(t,g,bg);
 301  matched_generation_bus(b,t,g,bg,'bid_power')$gb(g,b) = pbg(t,g,bg);
 302  matched_generation_bus(b,t,g,bg,'matched_P')$gb(g,b) = PG.l(t,g,bg);
 303  * Positive inflow (= generation unit):
 304  matched_inflow_bus(b,t,b_o,in,'bid_price')$(l(b_o,b) and P.l(t,b_o,b)>0) = NODAL_MARKET.m(t,b_o);
 305  matched_inflow_bus(b,t,b_o,in,'bid_power')$(l(b_o,b) and P.l(t,b_o,b)>0) = P.up(t,b_o,b);
 306  matched_inflow_bus(b,t,b_o,in,'matched_P')$(l(b_o,b) and P.l(t,b_o,b)>0) = P.l(t,b_o,b);
 307  * Negative outflow (= positive inflow = generation unit):
 308  matched_inflow_bus(b,t,b_d,in,'bid_price')$(l(b,b_d) and P.l(t,b,b_d)<0) = NODAL_MARKET.m(t,b_d);
 309  matched_inflow_bus(b,t,b_d,in,'bid_power')$(l(b,b_d) and P.l(t,b,b_d)<0) = P.up(t,b,b_d);
 310  matched_inflow_bus(b,t,b_d,in,'matched_P')$(l(b,b_d) and P.l(t,b,b_d)<0) = -P.l(t,b,b_d);
 311  *
 312  * Demand units
 313  *
 314  matched_demand_bus(b,t,d,bd,'bid_price')$db(d,b)     = lbd(t,d,bd);
 315  matched_demand_bus(b,t,d,bd,'bid_power')$db(d,b)     = pbd(t,d,bd);
 316  matched_demand_bus(b,t,d,bd,'matched_P')$db(d,b)     = PD.l(t,d,bd);
 317  * Positive outflow (= demand unit):
 318  matched_outflow_bus(b,t,b_d,ou,'bid_price')$(l(b,b_d) and P.l(t,b,b_d)>0) = NODAL_MARKET.m(t,b_d);
 319  matched_outflow_bus(b,t,b_d,ou,'bid_power')$(l(b,b_d) and P.l(t,b,b_d)>0) = P.up(t,b,b_d);
 320  matched_outflow_bus(b,t,b_d,ou,'matched_P')$(l(b,b_d) and P.l(t,b,b_d)>0) = P.l(t,b,b_d);
 321  * Negative inflow ( = positive outflow = demand unit):
 322  matched_outflow_bus(b,t,b_o,ou,'bid_price')$(l(b_o,b) and P.l(t,b_o,b)<0) = NODAL_MARKET.m(t,b_o);
 323  matched_outflow_bus(b,t,b_o,ou,'bid_power')$(l(b_o,b) and P.l(t,b_o,b)<0) = P.up(t,b_o,b);
 324  matched_outflow_bus(b,t,b_o,ou,'matched_P')$(l(b_o,b) and P.l(t,b_o,b)<0) = -P.l(t,b_o,b);
 325   
 326  display
 327  matched_generation_bus, matched_inflow_bus,
 328  matched_demand_bus,     matched_outflow_bus;
INCLUDE    C:\Users\citcea\Documents\GitHub\MUSAE\MUSAE_energy_markets\exercise7\TCMPA\TCMPA_disp_settlement.gms
 330  ********************************************************************************
 331  * F.-Javier Heredia f.javier.heredia(at)upc.edu http://gnom.upc.edu/heredia
 332  * Code under Creative Commons Attribution-NonCommercial-NoDerivs
 333  * 3.0 Unported License http://creativecommons.org/licenses/by-nc-nd/3.0/
 334  ********************************************************************************
 335   
 336  *
 337  * Settlement
 338  *
 339  SET rsg  Rows for generation settlement  / Revenue, 'Total rev.', Surplus, 'Total sur.'/;
 340  SET rsd  Rows for demand settlement      / Payment, 'Total pay.', Surplus, 'Total sur.'/;
 341  PARAMETER
 342  settlementG(rsg, g, t),
 343  settlementD(rsd, d, t),
 344  settlementGT(rsg, t),
 345  settlementDT(rsd, t);
 346  loop(t,
 347           loop(g,
 348                   settlementG('Revenue',g,t) =
 349                           sum(b$gb(g,b),NODAL_MARKET.m(t,b)*PGT.l(t,g));
 350                   settlementG('Surplus',g,t) =
 351                           settlementG('Revenue',g,t) - sum(bg,lbg(t,g,bg)*PG.l(t,g,bg))
 352           );
 353           settlementGT('Total rev.',t) = sum(g,settlementG('Revenue',g,t));
 354           settlementGT('Total sur.',t) = sum(g,settlementG('Surplus',g,t));
 355           loop(d,
 356                   settlementD('Payment',d,t) =
 357                           sum(b$db(d,b),NODAL_MARKET.m(t,b)*PDT.l(t,d));
 358                   settlementD('Surplus',d,t) =
 359                           sum(bd,lbd(t,d,bd)*PD.l(t,d,bd))- settlementD('Payment',d,t)
 360           );
 361           settlementDT('Total pay.',t) = sum(d,settlementD('Payment',d,t));
 362           settlementDT('Total sur.',t) = sum(d,settlementD('Surplus',d,t));
 363  );
 364   
 365  display settlementG, settlementD, settlementGT, settlementDT;
 366   
 367  *********************************************************************
 368  * Matlab INPUT FILES FOR MARKET CLEARING PLOTS...
 369  *********************************************************************
 370  * ... for TCMPA_BF.m
 371  *$ include TCMPA2M_T
 372  * ... for TCMPA_BFNodal.m
 373  SET bout(b) /'bus2'/
INCLUDE    C:\Users\citcea\Documents\GitHub\MUSAE\MUSAE_energy_markets\exercise7\TCMPA\TCMPA2M.gms
 375  ********************************************************************************
 376  * F.-Javier Heredia f.javier.heredia(at)upc.edu http://gnom.upc.edu/heredia
 377  * Code under Creative Commons Attribution-NonCommercial-NoDerivs
 378  * 3.0 Unported License http://creativecommons.org/licenses/by-nc-nd/3.0/
 379  ********************************************************************************
 380   
 381  file TCMPA_bus /TCMPA_bus.dat/;
 382  file TCMPA_eq  /TCMPA_eq.dat/;
 383  file TCMPA_lbg /TCMPA_lbg.dat/;
 384  file TCMPA_pbg /TCMPA_pbg.dat/;
 385  file TCMPA_PG  /TCMPA_PG.dat/;
 386  file TCMPA_lbd /TCMPA_lbd.dat/;
 387  file TCMPA_pbd /TCMPA_pbd.dat/;
 388  file TCMPA_PD  /TCMPA_PD.dat/;
 389   
 390  put TCMPA_bus; loop(bout, put bout.tl);
 391  put TCMPA_eq;
 392  scalar aux;
 393  loop(b$bout(b),
 394           loop(t,
 395                   put market_equilibrium(t,b,'energy');
 396                   put market_equilibrium(t,b,'price');
 397                   put market_equilibrium(t,b,'nodal SW');
 398                   put /
 399           );
 400  );
 401   
 402  loop(b$bout(b),
 403  put TCMPA_lbg;
 404  loop(t,
 405           loop(g$gb(g,b), loop(bg, put  lbg(t,g,bg)));
 406  *        Positive Inflow => generation unit
 407           loop(b_o$(l(b_o,b) and P.l(t,b_o,b)>0), put NODAL_MARKET.m(t,b_o));
 408  *        Negative Outflow => generation unit
 409           loop(b_d$(l(b,b_d) and P.l(t,b,b_d)<0), put NODAL_MARKET.m(t,b_d));
 410           put /);
 411  put TCMPA_pbg;
 412  loop(t,
 413           loop(g$gb(g,b), loop(bg, put  pbg(t,g,bg)));
 414  *        Positive Inflow => generation unit
 415           loop(b_o$(l(b_o,b) and P.l(t,b_o,b)>0), put  P.up(t,b_o,b));
 416  *        Negative Outflow => generation unit
 417           loop(b_d$(l(b,b_d) and P.l(t,b,b_d)<0), aux = -P.lo(t,b,b_d); put aux);
 418           put /);
