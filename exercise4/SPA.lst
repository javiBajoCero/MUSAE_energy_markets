C o m p i l a t i o n


   8   
   9  *********************************************************************
  10  * DATA
  11  *********************************************************************
  12   
  13  * Generation units:
  14   
  15  SETS
  16  g Generation units / G1/
  17  bg Blocks           /1*2/;
  18   
  19  PARAMETERS
  20  pg_max(g) Max. active power generation [MW] /G1 30/
  21  pg_min(g) Min. active power generation [MW] /G1  15/
  22  ru(g)     Ramp-up limit [MW:h]              /G1  5/
  23  rd(g)     Ramp-down limit [MW]              /G1  5/
  24  p0(g)     Initial power output [MW]         /G1 30/;
  25   
  26  TABLE pbg(g,bg) Power [MW] of the generation bid function
  27       1  2
  28  G1   15 15 ;
  29   
  30  TABLE lbg(g,bg) Prices [eur:MWh] of the generation bid function
  31       1  2
  32  G1   3  6 ;
  33   
  34  * Demand units:
  35   
  36  SETS
  37  d Generation units / D1, D2 /
  38  bd Blocks          / 1*2 /;
  39   
  40  TABLE pbd(d,bd) Power [MW] of the demand bid function
  41      1   2
  42  D1  10 10
  43  D2  10 10;
  44   
  45  TABLE lbd(d,bd) Prices [�:MWh] of the generation bid function
  46      1  2
  47  D1  8  1
  48  D2  7  2 ;
  49   
  50  display pbg, lbg, pbd, lbd;
  51   
  52  *********************************************************************
  53  * VARIABLES
  54  *********************************************************************
  55   
  56  FREE VARIABLE     SW       Social welfare (objective function)
  57  POSITIVE VARIABLE PG(g,bg) Matched generation of each block [MW]
  58                    PD(d,bd) Matched demand of each block [MW];
  59  BINARY VARIABLE   U(g)    on-off state of the unit;
  60   
  61  *********************************************************************
  62  * OBJECTIVE FUNCTION AND CONSTRAINTS
  63  *********************************************************************
  64   
  65  EQUATIONS
  66  OF         Objective function
  67  MATCHED_G  Matched generation to generation block coupling
  68  MATCHED_D  Matched demand to demand block coupling
  69  MARKET     Market equilibrium
  70  RAMP_D     Ramp down limit constraints
  71  RAMP_U     Ramp up limit constraints
  72  PGMIN      Minimum generation
  73  PGMAX      Maximum generation;
  74   
  75  * Social Welfare:
  76  OF.. SW =e=  sum(d, sum(bd, lbd(d,bd)*PD(d,bd)))
  77             - sum(g, sum(bg,lbg(g,bg)*PG(g,bg)));
  78   
  79  * Matched generation to generation block coupling:
  80  MATCHED_G(g,bg).. PG(g,bg) =l= pbg(g,bg);
  81   
  82  * Matched demand to demand block coupling:
  83  MATCHED_D(d,bd).. PD(d,bd) =l= pbd(d,bd);
  84   
  85  * Market Equilibrium:
  86  MARKET.. sum(d, sum(bd, PD(d,bd) )) =e=
  87           sum(g, sum(bg, PG(g,bg) ));
  88   
  89  * Ramp down limit:
  90  RAMP_D(g).. sum(bg, PG(g,bg)) - p0(g) =g= - rd(g);
  91   
  92  * Ramp up limit:
  93  RAMP_U(g).. sum(bg, PG(g,bg)) - p0(g) =l=   ru(g);
  94   
  95  * Generation limits:
  96  PGMIN(g)..  sum(bg, PG(g,bg)) =g= pg_min(g)*U(g);
  97  PGMAX(g)..  sum(bg, PG(g,bg)) =l= pg_max(g)*U(g);
  98   
  99  *********************************************************************
 100  * OPTIMIZATION
 101  *********************************************************************
 102   
 103  SET sc Columns for tables "_s" /bid_price, bid_power, SPA0 , SPA/;
 104  SET req Rows for market clearing tables / SocWel , price, energy/;
 105  SET mod Columns for market clearing tables / SPA0 , SPA/;
 106  PARAMETER
 107  matched_generation(g,bg,sc), total_matched_generation(g,sc),
 108  matched_demand(d,bd,sc), total_matched_demand(d,sc),
 109  market_equilibrium(req,mod);
 110  * Lagrange multipliers mu;
 111  SET mucolG / 'la^*=', 'la^b', '-mu^0', '-mu^b' /;
 112  SET mucolD / 'la^*=', 'la^b', '+mu^0', '+mu^b' /;
 113  PARAMETERS muG_0(g,bg,mucolG),muD_0(d,bd,mucolD);
 114   
 115  matched_generation(g,bg,'bid_price') = lbg(g,bg);
 116  matched_generation(g,bg,'bid_power') = pbg(g,bg);
 117  matched_demand(d,bd,'bid_price')     = lbd(d,bd);
 118  matched_demand(d,bd,'bid_power')     = pbd(d,bd);
 119   
 120  muG_0(g,bg,'la^b') = lbg(g,bg);
 121  muD_0(d,bd,'la^b') = lbd(d,bd);
 122   
 123  * Simplified model (LP):
 124   
 125  MODEL SPA0  / OF, MATCHED_G, MATCHED_D, MARKET/;
 126  SOLVE SPA0 USING lp MAXIMIZING SW;
 127   
 128  matched_generation(g,bg,'SPA0')     = PG.l(g,bg);
 129  total_matched_generation(g,'SPA0')  = sum(bg,PG.l(g,bg));
 130  matched_demand(d,bd,'SPA0')         = PD.l(d,bd);
 131  total_matched_demand(d,'SPA0')      = sum(bd,PD.l(d,bd));
 132  market_equilibrium('SocWel','SPA0') = SW.l;
 133  market_equilibrium('price', 'SPA0') = MARKET.m;
 134  market_equilibrium('energy', 'SPA0')= sum(d, sum( bd,PD.l(d,bd)));
 135   
 136  muG_0(g,bg,'la^*=')    = MARKET.m;
 137  muD_0(d,bd,'la^*=')    = MARKET.m;
 138  * The signs of the lag. mult. in GAMS are the opposite of those defined in classroom;
 139  muG_0(g,bg,'-mu^0') = PG.m(g,bg);
 140  muG_0(g,bg,'-mu^b') = MATCHED_G.m(g,bg);
 141  muD_0(d,bd,'+mu^0') = -PD.m(d,bd);
 142  muD_0(d,bd,'+mu^b') = -MATCHED_D.m(d,bd);
 143   
 144  * Full model (MIP):
 145   
 146  MODEL SPA    / ALL /;
 147  SOLVE SPA USING mip MAXIMIZING SW;
 148   
 149  matched_generation(g,bg,'SPA')   = PG.l(g,bg);
 150  total_matched_generation(g,'SPA')= sum(bg,PG.l(g,bg));
 151  matched_demand(d,bd,'SPA')       = PD.l(d,bd);
 152  total_matched_demand(d,'SPA')    = sum(bd,PD.l(d,bd));
 153  market_equilibrium('SocWel','SPA') = SW.l;
 154  market_equilibrium('energy', 'SPA')= sum(d, sum( bd,PD.l(d,bd)));
 155   
 156  * Continuous problem associated to SPA (CSPA):
 157   
 158  * We first set the optimal value of the binary variables;
 159  U.fx(g) = U.l(g);
 160  * And then solve the linear relaxation of SPA;
 161  SOLVE SPA USING rmip MAXIMIZING SW;
 162  market_equilibrium('price', 'SPA') = MARKET.m;
 163   
 164  * Output:
 165   
 166  display
 167  matched_generation, total_matched_generation,
 168  matched_demand    , total_matched_demand,
 169  market_equilibrium,
 170  muG_0, muD_0;
 171   
